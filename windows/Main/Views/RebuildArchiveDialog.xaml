<Window x:Class="RainExplorer.Views.RebuildArchiveDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rebuild ZIP copy"
        Width="540" SizeToContent="Height" MinWidth="480"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="{DynamicResource AppFont}" FontSize="13"
        AutomationProperties.Name="Rebuild ZIP to a distinct copy"
        AutomationProperties.HelpText="Choose an advertised ZIP compression preset and a distinct absent destination. The currently opened original remains unchanged.">
    <Window.Style>
        <Style TargetType="Window">
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Style>
    <Window.Resources>
        <Style x:Key="RebuildSurface" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource MenuBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Line2}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RebuildMutedText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RebuildField" TargetType="TextBox" BasedOn="{StaticResource FieldBox}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RebuildCombo" TargetType="ComboBox"
               BasedOn="{StaticResource {x:Type ComboBox}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ComboBox">
                                <Grid>
                                    <ToggleButton Focusable="False" ClickMode="Press"
                                                  Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                                                  Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"
                                                  BorderBrush="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"
                                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                      RelativeSource={RelativeSource TemplatedParent}}">
                                        <DockPanel Margin="8,0">
                                            <TextBlock DockPanel.Dock="Right" Text="▼" Margin="8,0,0,0"
                                                       Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"
                                                       VerticalAlignment="Center" />
                                            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                              TextElement.Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"
                                                              VerticalAlignment="Center" />
                                        </DockPanel>
                                    </ToggleButton>
                                    <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                                           Focusable="False" IsOpen="{TemplateBinding IsDropDownOpen}">
                                        <Border Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                                                BorderBrush="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"
                                                BorderThickness="1"
                                                MinWidth="{Binding ActualWidth,
                                                    RelativeSource={RelativeSource TemplatedParent}}">
                                            <ScrollViewer MaxHeight="240"
                                                          TextElement.Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}">
                                                <ItemsPresenter />
                                            </ScrollViewer>
                                        </Border>
                                    </Popup>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RebuildComboItem" TargetType="ComboBoxItem"
               BasedOn="{StaticResource {x:Type ComboBoxItem}}">
            <Setter Property="Padding" Value="10,6" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ComboBoxItem">
                                <Border x:Name="ItemBorder" Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsHighlighted" Value="True">
                                        <Setter TargetName="ItemBorder" Property="Background"
                                                Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="ItemBorder" Property="Background"
                                                Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <ControlTemplate x:Key="RebuildHighContrastButtonTemplate" TargetType="Button">
            <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                    Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                  RecognizesAccessKey="True"
                                  TextElement.Foreground="{TemplateBinding Foreground}" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="ButtonBorder" Property="Background"
                            Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                    <Setter Property="Foreground"
                            Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="ButtonBorder" Property="Background"
                            Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                    <Setter Property="Foreground"
                            Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter TargetName="ButtonBorder" Property="BorderThickness" Value="2" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground"
                            Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style x:Key="RebuildButton" TargetType="Button"
               BasedOn="{StaticResource DialogButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                    <Setter Property="Template" Value="{StaticResource RebuildHighContrastButtonTemplate}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RebuildPrimaryButton" TargetType="Button"
               BasedOn="{StaticResource PrimaryButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                    <Setter Property="Template" Value="{StaticResource RebuildHighContrastButtonTemplate}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RebuildValidationText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Danger}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Border Style="{StaticResource RebuildSurface}" BorderThickness="1" CornerRadius="12" Padding="20">
        <StackPanel>
            <DockPanel MouseLeftButtonDown="Title_Drag">
                <Path DockPanel.Dock="Left" Style="{StaticResource IconPath}"
                      Width="20" Height="20" Data="{StaticResource Ic.archive}"
                      Stroke="{DynamicResource AccentBright}" VerticalAlignment="Center" />
                <TextBlock Margin="10,0,0,0" FontSize="16" FontWeight="SemiBold"
                           Text="Rebuild ZIP to a new copy" VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock Margin="0,10,0,14" Style="{StaticResource RebuildMutedText}"
                       Text="The current session and fingerprint are checked again before dispatch. The original is never overwritten, edited, or deleted."
                       TextWrapping="Wrap" />
            <TextBlock FontWeight="SemiBold" Text="Compression preset" />
            <ComboBox x:Name="PresetInput" Height="34" Margin="0,5,0,0"
                      Style="{StaticResource RebuildCombo}"
                      ItemContainerStyle="{StaticResource RebuildComboItem}"
                      KeyboardNavigation.TabIndex="0"
                      AutomationProperties.Name="Worker-advertised ZIP rebuild preset" />
            <TextBlock Margin="0,14,0,5" FontWeight="SemiBold" Text="New ZIP destination" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="DestinationInput" Height="34" Style="{StaticResource RebuildField}"
                         KeyboardNavigation.TabIndex="1"
                         AutomationProperties.Name="Distinct ZIP rebuild destination"
                         AutomationProperties.HelpText="Enter a fully qualified absent ZIP path under an ordinary existing folder." />
                <Button Grid.Column="1" Margin="10,0,0,0" Height="34"
                        Style="{StaticResource RebuildButton}" Content="_Browse"
                        KeyboardNavigation.TabIndex="2" Click="Browse_Click"
                        AutomationProperties.Name="Browse for ZIP rebuild destination" />
            </Grid>
            <TextBlock Margin="0,14,0,0" Style="{StaticResource RebuildMutedText}"
                       Text="Final review: full ZIP copy only. No add, replace, delete, rename, metadata, encryption, split, overwrite, pause, or retry."
                       TextWrapping="Wrap" />
            <DockPanel Margin="0,16,0,0">
                <TextBlock x:Name="ValidationText" DockPanel.Dock="Left" MaxWidth="300"
                           Style="{StaticResource RebuildValidationText}" TextWrapping="Wrap"
                           AutomationProperties.Name="ZIP rebuild validation"
                           AutomationProperties.LiveSetting="Assertive" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="_Cancel" IsCancel="True" Margin="0,0,8,0"
                            Style="{StaticResource RebuildButton}" KeyboardNavigation.TabIndex="3"
                            AutomationProperties.Name="Cancel ZIP rebuild review" />
                    <Button Content="_Rebuild copy" IsDefault="True"
                            Style="{StaticResource RebuildPrimaryButton}" KeyboardNavigation.TabIndex="4"
                            Click="Rebuild_Click"
                            AutomationProperties.Name="Rebuild ZIP through the connected worker" />
                </StackPanel>
            </DockPanel>
        </StackPanel>
    </Border>
</Window>
