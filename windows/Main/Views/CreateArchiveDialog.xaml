<Window x:Class="RainExplorer.Views.CreateArchiveDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create archive"
        Width="660" Height="560" MinWidth="560" MinHeight="480"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="{DynamicResource AppFont}" FontSize="13"
        AutomationProperties.Name="Create managed archive"
        AutomationProperties.HelpText="Review the newest physical selection, a format and preset advertised by the connected archive worker, and a distinct new destination.">
    <Window.Style>
        <Style TargetType="Window">
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Style>
    <Window.Resources>
        <Style x:Key="ArchiveDialogSurface" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource MenuBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Line2}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ArchiveDialogMutedText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ArchiveDialogField" TargetType="TextBox" BasedOn="{StaticResource FieldBox}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ArchiveDialogCombo" TargetType="ComboBox"
               BasedOn="{StaticResource {x:Type ComboBox}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ComboBox">
                                <Grid>
                                    <ToggleButton Focusable="False" ClickMode="Press"
                                                  Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                                                  Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"
                                                  BorderBrush="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"
                                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                      RelativeSource={RelativeSource TemplatedParent}}">
                                        <DockPanel Margin="8,0">
                                            <TextBlock DockPanel.Dock="Right" Text="▼" Margin="8,0,0,0"
                                                       Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"
                                                       VerticalAlignment="Center" />
                                            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                              TextElement.Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"
                                                              VerticalAlignment="Center" />
                                        </DockPanel>
                                    </ToggleButton>
                                    <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                                           Focusable="False" IsOpen="{TemplateBinding IsDropDownOpen}">
                                        <Border Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                                                BorderBrush="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"
                                                BorderThickness="1"
                                                MinWidth="{Binding ActualWidth,
                                                    RelativeSource={RelativeSource TemplatedParent}}">
                                            <ScrollViewer MaxHeight="240"
                                                          TextElement.Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}">
                                                <ItemsPresenter />
                                            </ScrollViewer>
                                        </Border>
                                    </Popup>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ArchiveDialogComboItem" TargetType="ComboBoxItem"
               BasedOn="{StaticResource {x:Type ComboBoxItem}}">
            <Setter Property="Padding" Value="10,6" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ComboBoxItem">
                                <Border x:Name="ItemBorder" Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsHighlighted" Value="True">
                                        <Setter TargetName="ItemBorder" Property="Background"
                                                Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="ItemBorder" Property="Background"
                                                Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ArchiveDialogFormatComboItem" TargetType="ComboBoxItem"
               BasedOn="{StaticResource ArchiveDialogComboItem}">
            <Setter Property="IsEnabled" Value="{Binding IsCompatible}" />
            <Setter Property="ToolTip" Value="{Binding Availability}" />
        </Style>
        <ControlTemplate x:Key="ArchiveDialogHighContrastButtonTemplate" TargetType="Button">
            <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                    Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                  RecognizesAccessKey="True"
                                  TextElement.Foreground="{TemplateBinding Foreground}" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="ButtonBorder" Property="Background"
                            Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                    <Setter Property="Foreground"
                            Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="ButtonBorder" Property="Background"
                            Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                    <Setter Property="Foreground"
                            Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter TargetName="ButtonBorder" Property="BorderThickness" Value="2" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground"
                            Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style x:Key="ArchiveDialogButton" TargetType="Button"
               BasedOn="{StaticResource DialogButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                    <Setter Property="Template" Value="{StaticResource ArchiveDialogHighContrastButtonTemplate}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ArchiveDialogPrimaryButton" TargetType="Button"
               BasedOn="{StaticResource PrimaryButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                    <Setter Property="Template" Value="{StaticResource ArchiveDialogHighContrastButtonTemplate}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ArchiveDialogValidationText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Danger}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ArchiveDialogReviewSurface" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Glass2}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Line2}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ArchiveDialogSourceList" TargetType="ListView">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ArchiveDialogSourceItem" TargetType="ListViewItem"
               BasedOn="{StaticResource FileRowStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ArchiveDialogColumnHeader" TargetType="GridViewColumnHeader"
               BasedOn="{StaticResource ColumnHeaderStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Style="{StaticResource ArchiveDialogSurface}"
            BorderThickness="1" CornerRadius="12" Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" MouseLeftButtonDown="Title_Drag">
                <Path DockPanel.Dock="Left" Style="{StaticResource IconPath}"
                      Width="20" Height="20" Data="{StaticResource Ic.package}"
                      Stroke="{DynamicResource AccentBright}" VerticalAlignment="Center" />
                <TextBlock Margin="10,0,0,0" FontSize="16" FontWeight="SemiBold"
                           Text="Create archive" VerticalAlignment="Center" />
            </DockPanel>

            <ScrollViewer x:Name="CreationBody" Grid.Row="1" Margin="0,10,0,0"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Focusable="False">
                <StackPanel Margin="0,0,4,0">
                    <TextBlock Margin="0,0,0,12"
                               Style="{StaticResource ArchiveDialogMutedText}"
                               Text="Choose a format and a new save location. Your original files stay untouched."
                               TextWrapping="Wrap" />

                    <TextBlock FontWeight="SemiBold" Text="Items to include" Margin="0,0,0,6" />
                    <Border Style="{StaticResource ArchiveDialogReviewSurface}"
                            BorderThickness="1"
                            CornerRadius="8" Padding="8">
                        <ListView x:Name="SourcesList" Height="144"
                                  Style="{StaticResource ArchiveDialogSourceList}"
                                  ItemContainerStyle="{StaticResource ArchiveDialogSourceItem}"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  AutomationProperties.Name="Items to include in the archive"
                                  AutomationProperties.HelpText="Item kind identifies a file or folder. Name in archive is its top-level name in the new archive. Current location shows the original item.">
                            <ListView.View>
                                <GridView ColumnHeaderContainerStyle="{StaticResource ArchiveDialogColumnHeader}">
                                    <GridViewColumn Header="Item kind" Width="80" DisplayMemberBinding="{Binding Kind}" />
                                    <GridViewColumn Header="Name in archive" Width="185" DisplayMemberBinding="{Binding ArchivePath}" />
                                    <GridViewColumn Header="Current location" Width="285" DisplayMemberBinding="{Binding SourcePath}" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Border>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Margin="0,0,0,5" FontWeight="SemiBold" Text="Archive format" />
                            <ComboBox x:Name="FormatInput" Height="34" KeyboardNavigation.TabIndex="0"
                                      Style="{StaticResource ArchiveDialogCombo}"
                                      ItemContainerStyle="{StaticResource ArchiveDialogFormatComboItem}"
                                      DisplayMemberPath="DisplayName" MaxDropDownHeight="300"
                                      SelectionChanged="FormatInput_SelectionChanged"
                                      AutomationProperties.Name="Worker-advertised archive format"
                                      AutomationProperties.HelpText="All creation formats advertised by the connected worker are listed. Formats that cannot represent the current selection remain visible and disabled with a reason." />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                            <TextBlock Margin="0,0,0,5" FontWeight="SemiBold" Text="Compression preset" />
                            <ComboBox x:Name="PresetInput" Height="34" KeyboardNavigation.TabIndex="1"
                                      Style="{StaticResource ArchiveDialogCombo}"
                                      ItemContainerStyle="{StaticResource ArchiveDialogComboItem}"
                                      AutomationProperties.Name="Worker-advertised compression preset" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Margin="0,8,0,0">
                        <TextBlock x:Name="CapabilitySummaryText"
                                   Style="{StaticResource ArchiveDialogMutedText}"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="CapabilityLimitText"
                                   Margin="0,4,0,0" Style="{StaticResource ArchiveDialogMutedText}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Margin="0,0,0,5" FontWeight="SemiBold" Text="Save archive as" />
                            <TextBox x:Name="DestinationInput" Height="34"
                                     Style="{StaticResource ArchiveDialogField}"
                                     KeyboardNavigation.TabIndex="2"
                                     AutomationProperties.Name="New archive destination"
                                     AutomationProperties.HelpText="Enter a fully qualified path under an ordinary existing folder. Existing destinations are preserved." />
                        </StackPanel>
                        <Button Grid.Column="1" Margin="10,25,0,0" Height="34"
                                Style="{StaticResource ArchiveDialogButton}" Content="_Browse"
                                KeyboardNavigation.TabIndex="3" Click="Browse_Click"
                                AutomationProperties.Name="Browse for new archive destination" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="2" Margin="0,15,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="ReviewText" Grid.Row="0"
                           Style="{StaticResource ArchiveDialogMutedText}"
                           AutomationProperties.Name="Archive creation final review"
                           AutomationProperties.LiveSetting="Polite" TextWrapping="Wrap" />
                    <TextBlock x:Name="ValidationText" Grid.Row="1" Margin="0,4,0,0"
                               Style="{StaticResource ArchiveDialogValidationText}"
                               AutomationProperties.Name="Archive creation validation"
                               AutomationProperties.LiveSetting="Assertive" TextWrapping="Wrap" />
                    <StackPanel Grid.Row="2" Margin="0,10,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button Content="_Cancel" IsCancel="True" Margin="0,0,8,0"
                                Style="{StaticResource ArchiveDialogButton}" KeyboardNavigation.TabIndex="4"
                                AutomationProperties.Name="Cancel archive creation review" />
                        <Button x:Name="CreateArchiveButton" Content="Cre_ate archive" IsDefault="True"
                                Style="{StaticResource ArchiveDialogPrimaryButton}" KeyboardNavigation.TabIndex="5"
                                Click="Create_Click"
                                AutomationProperties.Name="Create archive through the connected worker" />
                    </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
