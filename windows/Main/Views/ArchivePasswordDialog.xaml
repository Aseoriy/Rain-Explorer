<Window
    x:Class="RainExplorer.Views.ArchivePasswordDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Password required"
    Width="440" SizeToContent="Height"
    WindowStyle="None" AllowsTransparency="True" Background="Transparent"
    ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
    FontFamily="{DynamicResource AppFont}" FontSize="13" Foreground="{StaticResource Text}"
    AutomationProperties.Name="Archive password prompt"
    AutomationProperties.HelpText="Enter a one-shot password for the encrypted archive. The visible password is cleared when this prompt closes; accepted characters are transferred for immediate clearing by the requesting operation.">

    <Window.Resources>
        <Style x:Key="ArchivePasswordField" TargetType="{x:Type PasswordBox}">
            <Setter Property="Background" Value="{StaticResource Glass2}" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line2}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type PasswordBox}">
                        <Border x:Name="PasswordBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="PasswordBorder" Property="BorderBrush"
                                        Value="{StaticResource AccentLine}" />
                                <Setter TargetName="PasswordBorder" Property="Background"
                                        Value="{StaticResource Glass3}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#F216161F" BorderBrush="{StaticResource Line2}"
            BorderThickness="1" CornerRadius="12" Padding="18">
        <Border.Effect>
            <DropShadowEffect Color="Black" Opacity="0.62" BlurRadius="32" ShadowDepth="5" />
        </Border.Effect>
        <StackPanel>
            <StackPanel Orientation="Horizontal" MouseLeftButtonDown="Title_Drag">
                <Path Style="{StaticResource IconPath}" Width="20" Height="20"
                      Data="{StaticResource Ic.shield}" Stroke="{StaticResource AccentBright}"
                      VerticalAlignment="Center" />
                <TextBlock Text="Password required" FontSize="15" FontWeight="SemiBold"
                           Margin="10,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="This archive is encrypted. Enter its password to continue."
                       Foreground="{StaticResource TextDim}" Margin="0,12,0,4"
                       TextWrapping="Wrap" />
            <TextBlock x:Name="ArchiveNameText" Foreground="{StaticResource TextMuted}"
                       Margin="0,0,0,10" MaxHeight="36" TextTrimming="CharacterEllipsis"
                       TextWrapping="NoWrap" AutomationProperties.Name="Encrypted archive name" />
            <PasswordBox x:Name="PasswordInput" Style="{StaticResource ArchivePasswordField}"
                         Height="32" KeyboardNavigation.TabIndex="0"
                         AutomationProperties.Name="Archive password"
                         AutomationProperties.HelpText="Enter the one-shot password required by the current archive request."
                         AutomationProperties.IsRequiredForForm="True" />
            <TextBlock Text="The password is used only for this request and is not saved."
                       Foreground="{StaticResource TextFaint}" Margin="0,8,0,0"
                       TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="_Cancel" Style="{StaticResource DialogButton}" IsCancel="True"
                        KeyboardNavigation.TabIndex="1" Margin="0,0,8,0"
                        AutomationProperties.Name="Cancel password prompt"
                        AutomationProperties.HelpText="Close the prompt without transferring a password." />
                <Button Content="_Continue" Style="{StaticResource PrimaryButton}" IsDefault="True"
                        KeyboardNavigation.TabIndex="2" Click="Continue_Click"
                        AutomationProperties.Name="Continue with archive password"
                        AutomationProperties.HelpText="Transfer this one-shot password to the current archive request." />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
