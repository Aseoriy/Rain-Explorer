<Window
    x:Class="RainExplorer.Views.GitIdentityDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="440" SizeToContent="Height"
    WindowStyle="None" AllowsTransparency="True" Background="Transparent"
    ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
    FontFamily="{DynamicResource AppFont}" FontSize="13" Foreground="{StaticResource Text}">

    <Border Background="{DynamicResource MenuBg}" BorderBrush="{StaticResource Line2}"
            BorderThickness="1" CornerRadius="12" Padding="18">
        <Border.Effect>
            <DropShadowEffect Color="Black" Opacity="0.62" BlurRadius="32" ShadowDepth="5" />
        </Border.Effect>
        <StackPanel>
            <TextBlock Text="Set your Git name and email" FontSize="15" FontWeight="SemiBold"
                       MouseLeftButtonDown="Title_Drag" />
            <TextBlock Foreground="{StaticResource TextDim}" TextWrapping="Wrap" Margin="0,10,0,0"
                       Text="Git saves these on every commit. They become public when you push to GitHub. To keep your email private, use the &quot;noreply&quot; address from GitHub → Settings → Emails." />
            <TextBlock Text="Name" Foreground="{StaticResource TextMuted}" Margin="0,12,0,4" />
            <TextBox x:Name="NameBox" Style="{StaticResource FieldBox}" Height="32"
                     AutomationProperties.Name="Name" />
            <TextBlock Text="Email" Foreground="{StaticResource TextMuted}" Margin="0,10,0,4" />
            <TextBox x:Name="EmailBox" Style="{StaticResource FieldBox}" Height="32"
                     AutomationProperties.Name="Email" />
            <CheckBox x:Name="RepoOnlyBox" Content="Only for this repository" Margin="0,12,0,0" />
            <TextBlock x:Name="ErrorText" Foreground="{StaticResource Danger}" TextWrapping="Wrap"
                       Margin="0,8,0,0" Visibility="Collapsed" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Cancel" Style="{StaticResource DialogButton}" IsCancel="True"
                        Click="Cancel_Click" Margin="0,0,8,0" />
                <Button Content="Save" Style="{StaticResource PrimaryButton}" IsDefault="True"
                        Click="Save_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
