<UserControl
    x:Class="RainExplorer.Controls.CommandBoxView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Command box: runs one command at a time in the pane's current folder (Ctrl+`) -->
    <Border Padding="14,8,14,10" Background="{DynamicResource Glass1}"
            BorderBrush="{DynamicResource Line1}" BorderThickness="0,1,0,0">
        <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="ClearButton" Style="{StaticResource IconButton}" Width="26" Height="24"
                            Click="Clear_Click" ToolTip="Clear the output" AutomationProperties.Name="Clear the output">
                        <Path Style="{StaticResource IconPath}" Width="13" Height="13" Data="{StaticResource Ic.trash}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                    <Button x:Name="TerminalButton" Style="{StaticResource IconButton}" Width="26" Height="24" Margin="2,0,0,0"
                            Click="Terminal_Click" ToolTip="Open a terminal here" AutomationProperties.Name="Open a terminal here">
                        <Path Style="{StaticResource IconPath}" Width="13" Height="13" Data="{StaticResource Ic.terminal}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                    <Button x:Name="CloseButton" Style="{StaticResource IconButton}" Width="26" Height="24" Margin="2,0,0,0"
                            Click="Close_Click" AutomationProperties.Name="Close the command box">
                        <Path Style="{StaticResource IconPath}" Width="13" Height="13" Data="{StaticResource Ic.x}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                </StackPanel>
                <TextBlock Text="COMMAND BOX" FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFaint}" />
                <TextBlock x:Name="FolderText" Margin="10,0,0,0" FontSize="11.5" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis"
                           FontFamily="{StaticResource MonoFont}" />
            </DockPanel>
            <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <Button x:Name="RunButton" DockPanel.Dock="Right" Content="Run" Style="{StaticResource PrimaryButton}"
                        Margin="8,0,0,0" Click="Run_Click" />
                <TextBlock x:Name="PromptText" DockPanel.Dock="Left" Text="&gt;" FontFamily="{StaticResource MonoFont}"
                           VerticalAlignment="Center" Foreground="{DynamicResource AccentBright}" Margin="2,0,8,0" />
                <TextBox x:Name="Input" Style="{StaticResource FieldBox}" Height="32" FontFamily="{StaticResource MonoFont}"
                         Tag="dir   ·   cd ..   ·   ↑ ↓ for history   ·   Esc closes"
                         PreviewKeyDown="Input_KeyDown" AutomationProperties.Name="Command to run in this folder" />
            </DockPanel>
            <ScrollViewer x:Name="OutputScroll" Height="140" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto" Background="{DynamicResource Glass2}" Padding="10,8">
                <TextBox x:Name="Output" IsReadOnly="True" Background="Transparent" BorderThickness="0" Padding="0"
                         FontFamily="{StaticResource MonoFont}" FontSize="11.5" Foreground="{DynamicResource TextDim}"
                         AutomationProperties.Name="Command output" />
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
