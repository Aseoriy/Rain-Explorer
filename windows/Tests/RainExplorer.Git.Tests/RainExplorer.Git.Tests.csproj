<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RainArchivesRoot Condition="'$(RainArchivesRoot)' == ''">$(MSBuildThisFileDirectory)..\..\..\rain-archives</RainArchivesRoot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Main\RainExplorer.csproj" />
    <ProjectReference Include="$(RainArchivesRoot)\src\RainArchives.Contracts\RainArchives.Contracts.csproj" />
    <ProjectReference Include="$(RainArchivesRoot)\src\RainArchives.Client\RainArchives.Client.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(RainArchivesRoot)\tests\fixtures\corpus\**\*"
          Link="fixtures\corpus\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="CopyRainArchivesWorkerForTests" AfterTargets="Build">
    <ItemGroup>
      <_RainArchivesWorkerFiles Include="$(RainArchivesRoot)\src\RainArchives.Worker\bin\$(Configuration)\net10.0-windows\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(_RainArchivesWorkerFiles)"
          DestinationFiles="@(_RainArchivesWorkerFiles->'$(OutDir)worker\%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Error Condition="!Exists('$(OutDir)worker\RainArchives.Worker.exe')"
           Text="The Rain Archives Worker test payload was not copied." />
  </Target>

</Project>
