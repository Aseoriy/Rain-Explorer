<UserControl
    x:Class="RainExplorer.Controls.PaneView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:svc="clr-namespace:RainExplorer.Services"
    xmlns:ctrl="clr-namespace:RainExplorer.Controls"
    Background="Transparent"
    Foreground="{StaticResource Text}"
    PreviewMouseDown="Root_PreviewMouseDown"
    PreviewKeyDown="Root_PreviewKeyDown">

    <UserControl.Resources>
        <ContextMenu x:Key="TabContextMenu" x:Shared="False"
                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                     Opened="TabContextMenu_Opened">
            <MenuItem Header="Duplicate tab" Click="TabDuplicate_Click" />
            <MenuItem Header="Reload" InputGestureText="F5" Click="TabReload_Click" />
            <MenuItem Tag="pin" Header="Pin tab" Click="TabPin_Click" />
            <Separator Tag="group-separator" />
            <MenuItem Tag="group-new" Header="New tab in group" Click="TabGroupNew_Click" />
            <MenuItem Tag="group-rename" Header="Rename tab group…" Click="TabGroupRename_Click" />
            <MenuItem Tag="group-remove" Header="Remove tab from group" Click="TabGroupRemove_Click" />
            <MenuItem Tag="group-clear" Header="Ungroup tabs" Click="TabGroupClear_Click" />
            <MenuItem Tag="group-close" Header="Close tab group" Click="TabGroupClose_Click" />
            <Separator />
            <MenuItem Header="Close tab" InputGestureText="Ctrl+W" Click="TabClose_Click" />
            <MenuItem Tag="close-other" Header="Close other tabs" Click="TabCloseOther_Click" />
            <MenuItem Tag="close-right" Header="Close tabs to the right" Click="TabCloseRight_Click" />
        </ContextMenu>

        <!-- Browser-style folder tab: glass when active, violet underline + accent icon -->
        <Style x:Key="TabItemStyle" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <EventSetter Event="MouseEnter" Handler="TabItem_MouseEnter" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border x:Name="bg" Background="Transparent" CornerRadius="8,8,0,0"
                                    BorderBrush="Transparent" BorderThickness="1,1,1,0"
                                    Padding="8,6" MinWidth="0" MaxWidth="208" ClipToBounds="True"
                                    ToolTipService.InitialShowDelay="450"
                                    ToolTipService.BetweenShowDelay="100"
                                    ToolTipService.ShowDuration="12000">
                                <Border.ToolTip>
                                    <ToolTip Placement="Bottom" HorizontalOffset="0" VerticalOffset="5"
                                             Background="{StaticResource MenuBg}"
                                             BorderBrush="{StaticResource Line2}" BorderThickness="1"
                                             Padding="8">
                                        <StackPanel Width="480">
                                            <Border Height="270" Background="{StaticResource Glass2}"
                                                    BorderBrush="{StaticResource Line2}" BorderThickness="1"
                                                    CornerRadius="8" ClipToBounds="True">
                                                <Grid>
                                                    <Image Source="{Binding PreviewImage}" Stretch="UniformToFill"
                                                           RenderOptions.BitmapScalingMode="HighQuality"
                                                           Visibility="{Binding PreviewImage,
                                                               Converter={StaticResource NullToVis}}" />
                                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                Visibility="{Binding PreviewImage,
                                                                    Converter={StaticResource NullToVis},
                                                                    ConverterParameter=invert}">
                                                        <Path Style="{StaticResource IconPath}" Width="28" Height="28"
                                                              Data="{StaticResource Ic.folder}"
                                                              Stroke="{StaticResource TextMuted}" />
                                                        <TextBlock Text="Preview appears after visiting this tab"
                                                                   Margin="0,10,0,0" FontSize="11"
                                                                   Foreground="{StaticResource TextFaint}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <TextBlock Text="{Binding TopLevelTitle}" Margin="2,9,2,0"
                                                       FontWeight="SemiBold" Foreground="{StaticResource Text}" />
                                            <TextBlock Text="{Binding CurrentPath}" Margin="2,3,2,0"
                                                       FontSize="11" Foreground="{StaticResource TextMuted}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </ToolTip>
                                </Border.ToolTip>
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="tabScale" ScaleX="1" ScaleY="1" />
                                </Border.RenderTransform>
                                <DockPanel LastChildFill="True">
                                    <Border x:Name="groupBadge" DockPanel.Dock="Right"
                                            Visibility="Collapsed" Background="{StaticResource AccentWash}"
                                            BorderBrush="{StaticResource AccentLine}" BorderThickness="1"
                                            CornerRadius="5" Padding="5,1" Margin="6,0,0,0">
                                        <TextBlock Text="{Binding GroupCount}" Foreground="{StaticResource AccentBright}"
                                                   FontSize="9" FontWeight="SemiBold" />
                                    </Border>
                                    <Path x:Name="ico" DockPanel.Dock="Left" Style="{StaticResource IconPath}"
                                          Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center"
                                          Data="{StaticResource Ic.folder}"
                                          Stroke="{StaticResource TextMuted}" />
                                    <Button x:Name="close" DockPanel.Dock="Right" Width="18" Height="18"
                                            Margin="4,0,0,0" Cursor="Hand" Background="Transparent"
                                            Foreground="{StaticResource TextFaint}"
                                            PreviewMouseLeftButtonDown="TabClose_PreviewMouseLeftButtonDown"
                                            PreviewMouseLeftButtonUp="TabClose_PreviewMouseLeftButtonUp"
                                            Command="{Binding DataContext.CloseTabCommand,
                                                      RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}" ToolTip="Close tab (Ctrl+W)"
                                            AutomationProperties.Name="Close tab">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="cb" Background="{TemplateBinding Background}"
                                                        CornerRadius="4">
                                                    <Path Style="{StaticResource IconPath}" Width="11" Height="11"
                                                          StrokeThickness="2" Data="{StaticResource Ic.x}"
                                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="cb" Property="Background" Value="{StaticResource Glass4}" />
                                                        <Setter Property="Foreground" Value="{StaticResource Text}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <Button x:Name="groupClose" DockPanel.Dock="Right" Width="18" Height="18"
                                            Margin="4,0,0,0" Cursor="Hand" Background="Transparent"
                                            Foreground="{StaticResource TextFaint}" Visibility="Collapsed"
                                            PreviewMouseLeftButtonDown="TabClose_PreviewMouseLeftButtonDown"
                                            PreviewMouseLeftButtonUp="TabClose_PreviewMouseLeftButtonUp"
                                            Command="{Binding DataContext.CloseGroupCommand,
                                                      RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}" ToolTip="Close tab group"
                                            AutomationProperties.Name="Close tab group">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="cb" Background="{TemplateBinding Background}"
                                                        CornerRadius="4">
                                                    <Path Style="{StaticResource IconPath}" Width="11" Height="11"
                                                          StrokeThickness="2" Data="{StaticResource Ic.x}"
                                                          Stroke="{Binding Foreground,
                                                              RelativeSource={RelativeSource AncestorType=Button}}" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="cb" Property="Background"
                                                                Value="{StaticResource Glass4}" />
                                                        <Setter Property="Foreground" Value="{StaticResource Text}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <TextBlock x:Name="title" Text="{Binding TopLevelTitle}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </Border>
                            <!-- violet underline on the active tab -->
                            <Border x:Name="ul" Height="2" CornerRadius="2" VerticalAlignment="Bottom"
                                    Margin="10,0" Background="{StaticResource GradientAccent}"
                                    Visibility="Collapsed">
                                <Border.Effect>
                                    <DropShadowEffect Color="#A855F7" BlurRadius="8" ShadowDepth="0" Opacity="0.7" />
                                </Border.Effect>
                            </Border>
                            <Border x:Name="groupRail" Height="3" CornerRadius="2"
                                    VerticalAlignment="Top" Margin="8,0"
                                    Background="{StaticResource AccentBright}"
                                    Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{StaticResource Glass3}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{StaticResource Glass3}" />
                                <Setter TargetName="bg" Property="BorderBrush" Value="{StaticResource Line2}" />
                                <Setter TargetName="ico" Property="Stroke" Value="{StaticResource AccentBright}" />
                                <Setter TargetName="ul" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{StaticResource Text}" />
                            </Trigger>
                            <!-- File drag hovering this tab: accent drop highlight -->
                            <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{StaticResource AccentWash}" />
                                <Setter TargetName="bg" Property="BorderBrush" Value="{StaticResource AccentLine}" />
                                <Setter TargetName="ico" Property="Stroke" Value="{StaticResource AccentBright}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsGrouped}" Value="True">
                                <Setter TargetName="groupRail" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsGroupLeader}" Value="True">
                                <Setter TargetName="groupBadge" Property="Visibility" Value="Visible" />
                                <Setter TargetName="close" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="groupClose" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsGroupDropTarget}" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{StaticResource AccentWash2}" />
                                <Setter TargetName="bg" Property="BorderBrush" Value="{StaticResource AccentBright}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsDragging}" Value="True">
                                <Setter Property="Panel.ZIndex" Value="20" />
                                <Setter Property="Opacity" Value="0.72" />
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="tabScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="0.96" Duration="0:0:0.10" />
                                            <DoubleAnimation Storyboard.TargetName="tabScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="0.96" Duration="0:0:0.10" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="tabScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1" Duration="0:0:0.13" />
                                            <DoubleAnimation Storyboard.TargetName="tabScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1" Duration="0:0:0.13" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                            <!-- Pinned tabs mimic browser favicons: compact, kept at the left,
                                 and their close affordance stays in the context menu. -->
                            <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                <Setter TargetName="bg" Property="Width" Value="38" />
                                <Setter TargetName="bg" Property="MinWidth" Value="38" />
                                <Setter TargetName="bg" Property="MaxWidth" Value="38" />
                                <Setter TargetName="bg" Property="Padding" Value="11,6" />
                                <Setter TargetName="ico" Property="Margin" Value="0" />
                                <Setter TargetName="title" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="close" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Compact second-row member tabs, matching Vivaldi's two-level tab stacks. -->
        <Style x:Key="GroupChildTabStyle" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <EventSetter Event="MouseEnter" Handler="TabItem_MouseEnter" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bg" Background="Transparent" CornerRadius="7"
                                BorderBrush="Transparent" BorderThickness="1"
                                Padding="7,4" MinWidth="0" MaxWidth="190" ClipToBounds="True"
                                ToolTipService.InitialShowDelay="450"
                                ToolTipService.BetweenShowDelay="100"
                                ToolTipService.ShowDuration="12000">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="groupTabScale" ScaleX="1" ScaleY="1" />
                            </Border.RenderTransform>
                            <Border.ToolTip>
                                <ToolTip Placement="Bottom" HorizontalOffset="0" VerticalOffset="5"
                                         Background="{StaticResource MenuBg}"
                                         BorderBrush="{StaticResource Line2}" BorderThickness="1"
                                         Padding="8">
                                    <StackPanel Width="480">
                                        <Border Height="270" Background="{StaticResource Glass2}"
                                                BorderBrush="{StaticResource Line2}" BorderThickness="1"
                                                CornerRadius="8" ClipToBounds="True">
                                            <Grid>
                                                <Image Source="{Binding PreviewImage}" Stretch="UniformToFill"
                                                       RenderOptions.BitmapScalingMode="HighQuality"
                                                       Visibility="{Binding PreviewImage,
                                                           Converter={StaticResource NullToVis}}" />
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                                            Visibility="{Binding PreviewImage,
                                                                Converter={StaticResource NullToVis},
                                                                ConverterParameter=invert}">
                                                    <Path Style="{StaticResource IconPath}" Width="28" Height="28"
                                                          Data="{StaticResource Ic.folder}"
                                                          Stroke="{StaticResource TextMuted}" />
                                                    <TextBlock Text="Preview appears after visiting this tab"
                                                               Margin="0,10,0,0" FontSize="11"
                                                               Foreground="{StaticResource TextFaint}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <TextBlock Text="{Binding Title}" Margin="2,9,2,0"
                                                   FontWeight="SemiBold" Foreground="{StaticResource Text}" />
                                        <TextBlock Text="{Binding CurrentPath}" Margin="2,3,2,0"
                                                   FontSize="11" Foreground="{StaticResource TextMuted}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </ToolTip>
                            </Border.ToolTip>
                            <DockPanel LastChildFill="True">
                                <Path x:Name="ico" DockPanel.Dock="Left" Style="{StaticResource IconPath}"
                                      Width="12" Height="12" Margin="0,0,5,0" VerticalAlignment="Center"
                                      Data="{StaticResource Ic.folder}" Stroke="{StaticResource TextMuted}" />
                                <Button x:Name="close" DockPanel.Dock="Right" Width="17" Height="17"
                                        Margin="4,0,0,0" Cursor="Hand" Background="Transparent"
                                        Foreground="{StaticResource TextFaint}"
                                        PreviewMouseLeftButtonDown="TabClose_PreviewMouseLeftButtonDown"
                                        PreviewMouseLeftButtonUp="TabClose_PreviewMouseLeftButtonUp"
                                        Command="{Binding DataContext.CloseTabCommand,
                                                  RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}" ToolTip="Close tab (Ctrl+W)"
                                        AutomationProperties.Name="Close tab">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="cb" Background="{TemplateBinding Background}" CornerRadius="4">
                                                <Path Style="{StaticResource IconPath}" Width="10" Height="10"
                                                      StrokeThickness="2" Data="{StaticResource Ic.x}"
                                                      Stroke="{Binding Foreground,
                                                          RelativeSource={RelativeSource AncestorType=Button}}" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="cb" Property="Background"
                                                            Value="{StaticResource Glass4}" />
                                                    <Setter Property="Foreground" Value="{StaticResource Text}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <TextBlock Text="{Binding Title}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{StaticResource Glass3}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{StaticResource AccentWash}" />
                                <Setter TargetName="bg" Property="BorderBrush" Value="{StaticResource AccentLine}" />
                                <Setter TargetName="ico" Property="Stroke" Value="{StaticResource AccentBright}" />
                                <Setter Property="Foreground" Value="{StaticResource Text}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsGroupDropTarget}" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{StaticResource AccentWash2}" />
                                <Setter TargetName="bg" Property="BorderBrush" Value="{StaticResource AccentBright}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsDragging}" Value="True">
                                <Setter Property="Opacity" Value="0.72" />
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="groupTabScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="0.96" Duration="0:0:0.10" />
                                            <DoubleAnimation Storyboard.TargetName="groupTabScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="0.96" Duration="0:0:0.10" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="groupTabScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1" Duration="0:0:0.13" />
                                            <DoubleAnimation Storyboard.TargetName="groupTabScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1" Duration="0:0:0.13" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Muted mono cell text for date / type / size -->
        <Style x:Key="MetaCell" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <!-- Keep the Details-view checkboxes tidy unless their setting is enabled.
             The optional selection-only mode reveals them for selected rows only. -->
        <Style x:Key="SelectionCheckboxStyle" TargetType="CheckBox"
               BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Source={x:Static svc:SettingsStore.Instance},
                                             Path=Settings.ShowCheckboxes}" Value="True" />
                        <Condition Binding="{Binding Source={x:Static svc:SettingsStore.Instance},
                                             Path=Settings.ShowCheckboxesOnSelectionOnly}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Source={x:Static svc:SettingsStore.Instance},
                                             Path=Settings.ShowCheckboxes}" Value="True" />
                        <Condition Binding="{Binding Source={x:Static svc:SettingsStore.Instance},
                                             Path=Settings.ShowCheckboxesOnSelectionOnly}" Value="True" />
                        <Condition Binding="{Binding IsSelected,
                                             RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Chrome-less text input (address / search): no border, no default
             chrome — just text + an optional Tag placeholder. -->
        <Style x:Key="BareBox" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="CaretBrush" Value="{StaticResource AccentBright}" />
            <Setter Property="SelectionBrush" Value="{StaticResource AccentWash2}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <TextBlock x:Name="ph" Text="{TemplateBinding Tag}" Visibility="Collapsed"
                                       Foreground="{StaticResource TextFaint}" IsHitTestVisible="False"
                                       VerticalAlignment="Center" />
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="ph" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Alternate layouts (List / Tiles / Grid) ===== -->
        <ItemsPanelTemplate x:Key="IconWrapPanel">
            <WrapPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>

        <!-- Selectable container for the icon layouts -->
        <Style x:Key="TileItemStyle" TargetType="ListViewItem">
            <Setter Property="Margin" Value="3" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="b" Background="Transparent" CornerRadius="9"
                                BorderBrush="Transparent" BorderThickness="1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource Glass3}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource AccentWash}" />
                                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource AccentLine}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- List: compact icon + name -->
        <DataTemplate x:Key="ListItemTemplate">
            <StackPanel Orientation="Horizontal" Width="232" Margin="8,5">
                <Grid Width="16" Height="16" Margin="0,0,9,0" VerticalAlignment="Center">
                    <Path Style="{StaticResource IconPath}" StrokeThickness="1.7"
                          Data="{Binding IconKey, Converter={StaticResource IconGeom}}"
                          Stroke="{Binding IconBrush}"
                          Visibility="{Binding Icon, Converter={StaticResource NullToVis}, ConverterParameter=invert}" />
                    <Image Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality"
                           SnapsToDevicePixels="True"
                           Visibility="{Binding Icon, Converter={StaticResource NullToVis}}" />
                </Grid>
                <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"
                           Foreground="{StaticResource Text}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>

        <!-- Tiles: medium icon + name + type, card-like -->
        <DataTemplate x:Key="TileTemplateMedium">
            <StackPanel Orientation="Horizontal" Width="216" Margin="10,8">
                <Grid Width="30" Height="30" Margin="0,0,12,0" VerticalAlignment="Center">
                    <Path Style="{StaticResource IconPath}" StrokeThickness="1.6"
                          Data="{Binding IconKey, Converter={StaticResource IconGeom}}"
                          Stroke="{Binding IconBrush}"
                          Visibility="{Binding Icon, Converter={StaticResource NullToVis}, ConverterParameter=invert}" />
                    <Image Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality"
                           SnapsToDevicePixels="True"
                           Visibility="{Binding Icon, Converter={StaticResource NullToVis}}" />
                </Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding DisplayName}" Foreground="{StaticResource Text}"
                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="150" />
                    <TextBlock Text="{Binding TypeLabel}" Foreground="{StaticResource TextMuted}"
                               FontSize="11" Margin="0,2,0,0" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <!-- Grid: photo thumbnail (when available) or large icon over centered name -->
        <DataTemplate x:Key="TileTemplateLarge">
            <StackPanel Width="132" Margin="6,10" HorizontalAlignment="Center">
                <Border Width="116" Height="82" CornerRadius="7" ClipToBounds="True"
                        Background="{StaticResource Glass2}" HorizontalAlignment="Center">
                    <Grid>
                        <Grid Visibility="{Binding GridThumbnail, Converter={StaticResource NullToVis},
                                                   ConverterParameter=invert}">
                            <Path Style="{StaticResource IconPath}" Width="46" Height="46"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  StrokeThickness="1.4"
                                  Data="{Binding IconKey, Converter={StaticResource IconGeom}}"
                                  Stroke="{Binding IconBrush}"
                                  Visibility="{Binding Icon, Converter={StaticResource NullToVis},
                                                       ConverterParameter=invert}" />
                            <Image Source="{Binding Icon}" Width="46" Height="46"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   SnapsToDevicePixels="True"
                                   Visibility="{Binding Icon, Converter={StaticResource NullToVis}}" />
                        </Grid>
                        <Image Source="{Binding GridThumbnail}" Stretch="UniformToFill"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               SnapsToDevicePixels="True"
                               Visibility="{Binding GridThumbnail, Converter={StaticResource NullToVis}}" />
                    </Grid>
                </Border>
                <TextBlock Text="{Binding DisplayName}" Foreground="{StaticResource Text}"
                           HorizontalAlignment="Center" TextAlignment="Center" Margin="0,8,0,0"
                           TextTrimming="CharacterEllipsis" TextWrapping="Wrap" MaxHeight="34"
                           MaxWidth="124" FontSize="12" />
            </StackPanel>
        </DataTemplate>

        <!-- Inline rename / new-folder editor: small frosted field with an accent edge. -->
        <Style x:Key="InlineEditBox" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource Glass3}" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="CaretBrush" Value="{StaticResource AccentBright}" />
            <Setter Property="SelectionBrush" Value="{StaticResource AccentWash2}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentLine}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="7,2" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Tab strip -->
        <Grid Grid.Row="0" Background="Transparent">
            <Grid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="New tab" InputGestureText="Ctrl+T" Click="TabStripNewTab_Click" />
                    <MenuItem Header="New tab in active group" Click="TabStripNewGroupTab_Click"
                              Visibility="{Binding HasActiveGroup, Converter={StaticResource BoolToVis}}" />
                    <Separator />
                    <MenuItem Header="Reopen last closed tab" Click="ReopenClosedTab_Click" />
                </ContextMenu>
            </Grid.ContextMenu>
            <Grid Margin="8,6,0,4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" VerticalAlignment="Bottom">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="ProjectsButton" Grid.Column="0" Style="{StaticResource IconButton}" Width="Auto"
                        MinWidth="88" Padding="9,0" VerticalAlignment="Bottom"
                        Margin="0,0,6,2" Click="ProjectsButton_Click" ToolTip="Switch tab project">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource IconPath}" Width="15" Height="15"
                              Data="{StaticResource Ic.package}" Margin="0,0,6,0"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        <TextBlock x:Name="ProjectsButtonText" Text="Tab projects"
                                   MaxWidth="170" TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Grid x:Name="TopTabDropSurface" Grid.Column="1" AllowDrop="True"
                      DragOver="TabBar_DragOver" DragLeave="TabBar_DragLeave" Drop="TabBar_Drop">
                    <ListBox x:Name="TabBar" ItemsSource="{Binding TopLevelTabs}"
                             SelectedItem="{Binding SelectedTopTab, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource TabItemStyle}"
                             Margin="0,0,36,0"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             AllowDrop="True"
                             DragOver="TabBar_DragOver"
                             DragLeave="TabBar_DragLeave"
                             Drop="TabBar_Drop"
                             PreviewMouseDown="TabBar_PreviewMouseDown"
                             PreviewMouseLeftButtonUp="TabBar_PreviewMouseLeftButtonUp"
                             PreviewMouseMove="TabBar_PreviewMouseMove"
                             GiveFeedback="TabBar_GiveFeedback"
                             QueryContinueDrag="TabBar_QueryContinueDrag"
                             MouseLeave="TabBar_MouseLeave"
                             LayoutUpdated="TabBar_LayoutUpdated"
                             ContextMenuOpening="TabBar_ContextMenuOpening">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ctrl:AdaptiveTabPanel MinimumItemWidth="52" MaximumItemWidth="208"
                                                       PinnedItemWidth="40" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>
                    <Button x:Name="NewTabButton" Style="{StaticResource IconButton}"
                            Width="32" Height="32" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                            Margin="0,0,0,2" Panel.ZIndex="30"
                            Command="{Binding NewTabCommand}" ToolTip="New tab (Ctrl+T)"
                            AutomationProperties.Name="New tab">
                        <Button.RenderTransform>
                            <TranslateTransform x:Name="NewTabButtonTransform" />
                        </Button.RenderTransform>
                        <Path Style="{StaticResource IconPath}" Width="16" Height="16" Data="{StaticResource Ic.plus}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                </Grid>
                </Grid>

                <Border Grid.Row="1" Margin="0,3,36,0" Padding="3,2"
                        Background="{StaticResource Glass2}" BorderBrush="{StaticResource Line1}"
                        BorderThickness="1" CornerRadius="8"
                        Visibility="{Binding HasActiveGroup, Converter={StaticResource BoolToVis}}">
                    <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                            Width="26" Height="24" Margin="4,0,0,0"
                            Click="NewActiveGroupTab_Click" ToolTip="New tab in this group">
                        <Path Style="{StaticResource IconPath}" Width="13" Height="13"
                              Data="{StaticResource Ic.plus}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                    <ListBox x:Name="GroupTabBar" ItemsSource="{Binding ActiveGroupTabs}"
                             SelectedItem="{Binding SelectedTab, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource GroupChildTabStyle}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             AllowDrop="True"
                             DragOver="TabBar_DragOver"
                             DragLeave="TabBar_DragLeave"
                             Drop="TabBar_Drop"
                             PreviewMouseDown="TabBar_PreviewMouseDown"
                             PreviewMouseLeftButtonUp="TabBar_PreviewMouseLeftButtonUp"
                             PreviewMouseMove="TabBar_PreviewMouseMove"
                             GiveFeedback="TabBar_GiveFeedback"
                             QueryContinueDrag="TabBar_QueryContinueDrag"
                             MouseLeave="TabBar_MouseLeave"
                             ContextMenuOpening="TabBar_ContextMenuOpening">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ctrl:AdaptiveTabPanel MinimumItemWidth="64" MaximumItemWidth="190"
                                                       PinnedItemWidth="64" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Navigation bar (scoped to the active tab) -->
        <Border Grid.Row="1" Background="Transparent"
                BorderBrush="{StaticResource Line1}" BorderThickness="0,0,0,1"
                Padding="12,8" DataContext="{Binding SelectedTab}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- nav buttons -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,8,0">
                    <Button Style="{StaticResource IconButton}" Command="{Binding BackCommand}" ToolTip="Back (Alt+Left)"
                            AutomationProperties.Name="Back">
                        <Path Style="{StaticResource IconPath}" Width="17" Height="17" Data="{StaticResource Ic.arrow-left}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                    <Button Style="{StaticResource IconButton}" Command="{Binding ForwardCommand}" ToolTip="Forward (Alt+Right)"
                            AutomationProperties.Name="Forward">
                        <Path Style="{StaticResource IconPath}" Width="17" Height="17" Data="{StaticResource Ic.arrow-right}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                    <Button Style="{StaticResource IconButton}" Command="{Binding UpCommand}" ToolTip="Up (Alt+Up)"
                            AutomationProperties.Name="Up one folder">
                        <Path Style="{StaticResource IconPath}" Width="17" Height="17" Data="{StaticResource Ic.arrow-up}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                    <Button Style="{StaticResource IconButton}" Command="{Binding RefreshCommand}" ToolTip="Refresh (F5)"
                            AutomationProperties.Name="Refresh folder">
                        <Path Style="{StaticResource IconPath}" Width="16" Height="16" Data="{StaticResource Ic.refresh}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                </StackPanel>

                <!-- Address bar: clickable breadcrumb that flips to an editable path box (Ctrl+L) -->
                <ctrl:BreadcrumbBar x:Name="AddressBar" Grid.Column="1" VerticalAlignment="Center" />

                <!-- Search pill: search glyph + filter + recursive toggle -->
                <Border Grid.Column="2" Width="210" Margin="8,0,0,0" Background="{StaticResource Glass2}"
                        BorderBrush="{StaticResource Line2}" BorderThickness="1" CornerRadius="8"
                        Height="30" VerticalAlignment="Center">
                    <DockPanel LastChildFill="True" Margin="10,0,2,0">
                        <Path DockPanel.Dock="Left" Style="{StaticResource IconPath}" Width="14" Height="14"
                              Margin="0,0,8,0" VerticalAlignment="Center"
                              Data="{StaticResource Ic.search}" Stroke="{StaticResource TextMuted}" />
                        <ToggleButton DockPanel.Dock="Right" Style="{StaticResource ToggleChip}"
                                      IsChecked="{Binding Recursive, Mode=TwoWay}"
                                      ToolTip="Search subfolders (recursive)"
                                      AutomationProperties.Name="Search subfolders recursively">
                            <Path Style="{StaticResource IconPath}" Width="15" Height="15" Data="{StaticResource Ic.recursive}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                        </ToggleButton>
                        <TextBox x:Name="SearchBox" Style="{StaticResource BareBox}" Tag="Search"
                                 Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>
                </Border>

                <!-- Sort / View / Split -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="8,0,0,0">
                    <!-- Sort menu -->
                    <Button x:Name="SortButton" Style="{StaticResource IconButton}"
                            Click="OpenButtonMenu_Click" Tag="Sort" ToolTip="Sort by"
                            AutomationProperties.Name="Sort files">
                        <Path Style="{StaticResource IconPath}" Width="16" Height="16" Data="{StaticResource Ic.sliders}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>

                    <!-- Layout menu -->
                    <Button x:Name="LayoutButton" Style="{StaticResource IconButton}" Margin="2,0,0,0"
                            Click="OpenButtonMenu_Click" Tag="Layout" ToolTip="Layout"
                            AutomationProperties.Name="Choose folder layout">
                        <Path Style="{StaticResource IconPath}" Width="16" Height="16" Data="{StaticResource Ic.list}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>

                    <!-- Preview pane toggle -->
                    <ToggleButton Style="{StaticResource ToggleChip}" Margin="2,0,0,0"
                                  IsChecked="{Binding Source={x:Static svc:SettingsStore.Instance},
                                      Path=Settings.ShowPreviewPane, Mode=TwoWay}"
                                  ToolTip="Preview pane (Space)"
                                  AutomationProperties.Name="Show preview pane">
                        <Path Style="{StaticResource IconPath}" Width="16" Height="16" Data="{StaticResource Ic.eye}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                    </ToggleButton>

                    <!-- Split toggle -->
                    <Button Style="{StaticResource IconButton}" Margin="2,0,0,0"
                            Command="{Binding DataContext.ToggleSplitCommand,
                                      RelativeSource={RelativeSource AncestorType=Window}}"
                            ToolTip="Toggle split view"
                            AutomationProperties.Name="Toggle split view">
                        <Path Style="{StaticResource IconPath}" Width="16" Height="16" Data="{StaticResource Ic.split}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="TabContentHost" Grid.Row="2" DataContext="{Binding SelectedTab}">
        <ctrl:HomeView Panel.ZIndex="2" Background="{DynamicResource AppBackgroundBrush}"
                       Visibility="{Binding IsHomeView, Converter={StaticResource BoolToVis}}" />
        <ctrl:DrivesView Panel.ZIndex="2" Background="{DynamicResource AppBackgroundBrush}"
                         Visibility="{Binding IsDrivesView, Converter={StaticResource BoolToVis}}" />
        <!-- Folder view: file list + marquee, with an optional preview pane on the right. -->
        <Grid Visibility="{Binding IsFolderView, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="240" />
                <ColumnDefinition x:Name="PreviewSplitterCol" Width="0" />
                <ColumnDefinition x:Name="PreviewCol" Width="0" />
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
        <ListView x:Name="FileList"
                  ItemsSource="{Binding Items}"
                  ItemContainerStyle="{StaticResource FileRowStyle}"
                  SelectionMode="Extended"
                  Background="Transparent" BorderThickness="0"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  AllowDrop="True"
                  SelectionChanged="FileList_SelectionChanged"
                  MouseDoubleClick="FileList_MouseDoubleClick"
                  PreviewMouseDown="FileList_PreviewMouseDown"
                  PreviewMouseLeftButtonDown="FileList_PreviewMouseLeftButtonDown"
                  PreviewMouseRightButtonDown="FileList_PreviewMouseRightButtonDown"
                  MouseLeftButtonUp="FileList_MouseLeftButtonUp"
                  MouseMove="FileList_MouseMove"
                  LostMouseCapture="FileList_LostMouseCapture"
                  DragOver="FileList_DragOver"
                  DragLeave="FileList_DragLeave"
                  Drop="FileList_Drop"
                  KeyDown="FileList_KeyDown"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling">
            <ListView.RenderTransform>
                <TranslateTransform x:Name="ListTransform" Y="0" />
            </ListView.RenderTransform>
            <ListView.ContextMenu>
                <ContextMenu Opened="FileContextMenu_Opened" Closed="FileContextMenu_Closed">
                    <MenuItem x:Name="MenuOpen" Header="Open" Click="Open_Click" FontWeight="SemiBold">
                        <MenuItem.Icon>
                            <Path Style="{StaticResource IconPath}" Width="15" Height="15" Data="{StaticResource Ic.arrow-right}"
                                  Stroke="{StaticResource AccentBright}" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem x:Name="MenuOpenNewTab" Header="Open in new tab" Click="OpenNewTab_Click">
                        <MenuItem.Icon>
                            <Path Style="{StaticResource IconPath}" Width="15" Height="15" Data="{StaticResource Ic.plus}"
                                  Stroke="{StaticResource TextMuted}" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem x:Name="MenuOpenWith" Header="Open with…" Click="OpenWith_Click">
                        <MenuItem.Icon>
                            <Path Style="{StaticResource IconPath}" Width="15" Height="15" Data="{StaticResource Ic.external-link}"
                                  Stroke="{StaticResource TextMuted}" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem x:Name="MenuOpenTerminal" Header="Open in Terminal" Click="OpenTerminal_Click">
                        <MenuItem.Icon>
                            <Path Style="{StaticResource IconPath}" Width="15" Height="15" Data="{StaticResource Ic.terminal}"
                                  Stroke="{StaticResource TextMuted}" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator />
                    <MenuItem x:Name="MenuCut" Header="Cut" InputGestureText="Ctrl+X" Click="Cut_Click">
                        <MenuItem.Icon>
                            <Path Style="{StaticResource IconPath}" Width="15" Height="15" Data="{StaticResource Ic.scissors}"
                                  Stroke="{StaticResource TextMuted}" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem x:Name="MenuCopy" Header="Copy" InputGestureText="Ctrl+C" Click="Copy_Click">
                        <MenuItem.Icon>
                            <Path Style="{StaticResource IconPath}" Width="15" Height="15" Data="{StaticResource Ic.copy}"
                                  Stroke="{StaticResource TextMuted}" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem x:Name="MenuCopyPath" Header="Copy as path" Click="CopyPath_Click">
                        <MenuItem.Icon>
                            <Path Style="{StaticResource IconPath}" Width="15" Height="15" Data="{StaticResource Ic.hash}"
                                  Stroke="{StaticResource TextMuted}" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem x:Name="MenuPaste" Header="Paste" InputGestureText="Ctrl+V" Click="Paste_Click">
                        <MenuItem.Icon>
                            <Path Style="{StaticResource IconPath}" Width="15" Height="15" Data="{StaticResource Ic.clipboard}"
                                  Stroke="{StaticResource TextMuted}" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator />
                    <MenuItem x:Name="MenuCompress" Header="Compress to ZIP" Click="Compress_Click">
                        <MenuItem.Icon>
                            <Path Style="{StaticResource IconPath}" Width="15" Height="15" Data="{StaticResource Ic.package}"
                                  Stroke="{StaticResource TextMuted}" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem x:Name="MenuExtract" Header="Extract here" Click="Extract_Click">
                        <MenuItem.Icon>
                            <Path Style="{StaticResource IconPath}" Width="15" Height="15" Data="{StaticResource Ic.archive}"
                                  Stroke="{StaticResource TextMuted}" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem x:Name="MenuShortcut" Header="Create shortcut" Click="CreateShortcut_Click">
                        <MenuItem.Icon>
                            <Path Style="{StaticResource IconPath}" Width="15" Height="15" Data="{StaticResource Ic.link}"
                                  Stroke="{StaticResource TextMuted}" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem x:Name="MenuPin" Header="Pin to Quick Access" Click="Pin_Click">
                        <MenuItem.Icon>
                            <Path Style="{StaticResource IconPath}" Width="15" Height="15" Data="{StaticResource Ic.star}"
                                  Stroke="{StaticResource AccentBright}" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator />
                    <MenuItem x:Name="MenuRename" Header="Rename" InputGestureText="F2" Click="Rename_Click">
                        <MenuItem.Icon>
                            <Path Style="{StaticResource IconPath}" Width="15" Height="15" Data="{StaticResource Ic.pencil}"
                                  Stroke="{StaticResource TextMuted}" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem x:Name="MenuDelete" Header="Delete" InputGestureText="Del" Click="Delete_Click">
                        <MenuItem.Icon>
                            <Path Style="{StaticResource IconPath}" Width="15" Height="15" Data="{StaticResource Ic.trash}"
                                  Stroke="{StaticResource Danger}" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator />
                    <MenuItem x:Name="MenuNewFolder" Header="New folder" Click="NewFolder_Click">
                        <MenuItem.Icon>
                            <Path Style="{StaticResource IconPath}" Width="15" Height="15" Data="{StaticResource Ic.folder-plus}"
                                  Stroke="{StaticResource AccentBright}" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem x:Name="MenuNewFile" Header="New text file" Click="NewTextFile_Click">
                        <MenuItem.Icon>
                            <Path Style="{StaticResource IconPath}" Width="15" Height="15" Data="{StaticResource Ic.file-plus}"
                                  Stroke="{StaticResource TextMuted}" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator />
                    <MenuItem x:Name="MenuProperties" Header="Properties" InputGestureText="Alt+Enter" Click="Properties_Click">
                        <MenuItem.Icon>
                            <Path Style="{StaticResource IconPath}" Width="15" Height="15" Data="{StaticResource Ic.info}"
                                  Stroke="{StaticResource TextMuted}" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator />
                    <MenuItem x:Name="MenuGit" Header="Git &amp; GitHub"
                              SubmenuOpened="GitMenu_SubmenuOpened">
                        <MenuItem Header="Checking repository…" IsEnabled="False" />
                    </MenuItem>
                    <Separator />
                    <MenuItem x:Name="MenuShowMore" Header="Show more options"
                              SubmenuOpened="ShowMore_SubmenuOpened">
                        <MenuItem.Icon>
                            <Path Style="{StaticResource IconPath}" Width="15" Height="15" Data="{StaticResource Ic.list}"
                                  Stroke="{StaticResource TextMuted}" />
                        </MenuItem.Icon>
                        <MenuItem Header="Loading…" IsEnabled="False" />
                    </MenuItem>
                </ContextMenu>
            </ListView.ContextMenu>
            <ListView.View>
                <GridView ColumnHeaderContainerStyle="{StaticResource ColumnHeaderStyle}">
                    <GridViewColumn x:Name="ColName" Header="Name" Width="380">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox VerticalAlignment="Center" Margin="0,0,8,0"
                                              Style="{StaticResource SelectionCheckboxStyle}"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay,
                                                  RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                    <Grid Width="17" Height="17" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <Path Style="{StaticResource IconPath}" StrokeThickness="1.7"
                                              Data="{Binding IconKey, Converter={StaticResource IconGeom}}"
                                              Stroke="{Binding IconBrush}"
                                              Visibility="{Binding Icon, Converter={StaticResource NullToVis}, ConverterParameter=invert}" />
                                        <Image Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality"
                                               SnapsToDevicePixels="True"
                                               Visibility="{Binding Icon, Converter={StaticResource NullToVis}}" />
                                    </Grid>
                                    <!-- Display mode -->
                                    <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"
                                               Foreground="{StaticResource Text}"
                                               TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding IsEditing,
                                                   Converter={StaticResource InverseBoolToVis}}" />
                                    <!-- Inline-rename mode -->
                                    <TextBox Style="{StaticResource InlineEditBox}"
                                             Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                                             MinWidth="160" Height="24" VerticalAlignment="Center"
                                             Visibility="{Binding IsEditing,
                                                 Converter={StaticResource BoolToVis}}"
                                             IsVisibleChanged="RenameBox_IsVisibleChanged"
                                             KeyDown="RenameBox_KeyDown"
                                             LostKeyboardFocus="RenameBox_LostKeyboardFocus" />
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn x:Name="ColDate" Header="Date modified" Width="158">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ModifiedText}" Style="{StaticResource MetaCell}"
                                           FontFamily="{StaticResource MonoFont}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn x:Name="ColCreated" Header="Date created" Width="158">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding CreatedText}" Style="{StaticResource MetaCell}"
                                           FontFamily="{StaticResource MonoFont}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn x:Name="ColType" Header="Type" Width="116">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding TypeLabel}" Style="{StaticResource MetaCell}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn x:Name="ColSize" Header="Size" Width="92">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding SizeText}" Style="{StaticResource MetaCell}"
                                           FontFamily="{StaticResource MonoFont}" HorizontalAlignment="Right"
                                           TextAlignment="Right" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- Rubber-band selection rectangle (drawn over the list; never hit-tested) -->
        <Canvas x:Name="MarqueeLayer" IsHitTestVisible="False">
            <Border x:Name="Marquee" Visibility="Collapsed" CornerRadius="2"
                    Background="{StaticResource AccentWash2}"
                    BorderBrush="{StaticResource AccentLine}" BorderThickness="1" />
        </Canvas>
            </Grid>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                          Background="{StaticResource Line1}"
                          DragCompleted="PreviewSplitter_DragCompleted"
                          Visibility="{Binding Source={x:Static svc:SettingsStore.Instance},
                              Path=Settings.ShowPreviewPane, Converter={StaticResource BoolToVis}}" />
            <ctrl:PreviewPane Grid.Column="2" x:Name="Preview"
                          Visibility="{Binding Source={x:Static svc:SettingsStore.Instance},
                              Path=Settings.ShowPreviewPane, Converter={StaticResource BoolToVis}}" />
        </Grid>
        </Grid>

        <!-- Status bar (toggleable via settings) -->
        <Border Grid.Row="3" Height="28" Background="{StaticResource Glass2}"
                DataContext="{Binding SelectedTab}"
                BorderBrush="{StaticResource Line1}" BorderThickness="0,1,0,0"
                Visibility="{Binding Source={x:Static svc:SettingsStore.Instance},
                    Path=Settings.ShowStatusBar, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding Status}" Foreground="{StaticResource TextMuted}"
                       VerticalAlignment="Center" Margin="14,0" FontSize="12" />
        </Border>

        <!-- Sort / Layout toolbar dropdowns: plain Popups (not ContextMenu — a ContextMenu's
             own mouse capture swallows the re-click on its own toggle button, see
             OpenButtonMenu_Click) so the open/close toggle is fully reliable. -->
        <Border x:Name="SortPopup" Grid.RowSpan="4" Panel.ZIndex="110"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,84,104,0"
                Background="{StaticResource MenuBg}" BorderBrush="{StaticResource Line2}"
                BorderThickness="1" CornerRadius="10" Padding="5" MinWidth="180"
                Visibility="Collapsed" Opacity="0">
            <Border.RenderTransform>
                <TranslateTransform Y="-6" />
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.5" BlurRadius="24" ShadowDepth="5" />
            </Border.Effect>
            <StackPanel>
                <MenuItem Header="Sort by" IsEnabled="False" FontWeight="SemiBold" />
                <MenuItem Header="Name" Tag="Name" Click="Sort_Click" />
                <MenuItem Header="Date modified" Tag="Modified" Click="Sort_Click" />
                <MenuItem Header="Date created" Tag="Created" Click="Sort_Click" />
                <MenuItem Header="Type" Tag="Type" Click="Sort_Click" />
                <MenuItem Header="Size" Tag="Size" Click="Sort_Click" />
                <Separator />
                <MenuItem Header="Reverse order" Click="ReverseSort_Click" />
            </StackPanel>
        </Border>

        <Border x:Name="LayoutPopup" Grid.RowSpan="4" Panel.ZIndex="110"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,84,64,0"
                Background="{StaticResource MenuBg}" BorderBrush="{StaticResource Line2}"
                BorderThickness="1" CornerRadius="10" Padding="5" MinWidth="140"
                Visibility="Collapsed" Opacity="0">
            <Border.RenderTransform>
                <TranslateTransform Y="-6" />
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.5" BlurRadius="24" ShadowDepth="5" />
            </Border.Effect>
            <StackPanel>
                <MenuItem Header="Layout" IsEnabled="False" FontWeight="SemiBold" />
                <MenuItem Header="Details" Tag="Details" Click="Layout_Click" />
                <MenuItem Header="List" Tag="List" Click="Layout_Click" />
                <MenuItem Header="Tiles" Tag="Tiles" Click="Layout_Click" />
                <MenuItem Header="Grid" Tag="Grid" Click="Layout_Click" />
            </StackPanel>
        </Border>

        <Border x:Name="ProjectsFlyout" Grid.RowSpan="4" Panel.ZIndex="100"
                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,42,0,0"
                Background="{StaticResource MenuBg}" BorderBrush="{StaticResource Line2}"
                BorderThickness="1" CornerRadius="10" Padding="5"
                MinWidth="240" MaxHeight="520" Visibility="Collapsed" Opacity="0">
            <Border.RenderTransform>
                <TranslateTransform x:Name="ProjectsFlyoutTransform" Y="-6" />
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.5" BlurRadius="24" ShadowDepth="5" />
            </Border.Effect>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ProjectsMenuItems" />
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
