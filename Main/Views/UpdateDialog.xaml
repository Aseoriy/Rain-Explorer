<Window
    x:Class="RainExplorer.Views.UpdateDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="500" SizeToContent="Height"
    WindowStyle="None" AllowsTransparency="True" Background="Transparent"
    ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
    FontFamily="{DynamicResource AppFont}" FontSize="13" Foreground="{StaticResource Text}">

    <Border Background="#F216161F" BorderBrush="{StaticResource Line2}"
            BorderThickness="1" CornerRadius="14" Padding="22">
        <Border.Effect>
            <DropShadowEffect Color="Black" Opacity="0.62" BlurRadius="34" ShadowDepth="6" />
        </Border.Effect>
        <StackPanel>
            <!-- Header -->
            <StackPanel Orientation="Horizontal" MouseLeftButtonDown="Title_Drag">
                <Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource AccentWash}">
                    <Path Style="{StaticResource IconPath}" Width="21" Height="21"
                          Data="{StaticResource Ic.download}" Stroke="{StaticResource AccentBright}"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Update available" FontSize="16" FontWeight="Bold" />
                    <TextBlock x:Name="SubtitleText" FontSize="12" Foreground="{StaticResource TextMuted}"
                               Margin="0,2,0,0" />
                </StackPanel>
                <Border x:Name="BetaBadge" Visibility="Collapsed" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Background="{StaticResource Glass4}"
                        CornerRadius="6" Padding="8,3" Margin="10,0,0,0">
                    <TextBlock Text="BETA" FontSize="10" FontWeight="Bold"
                               Foreground="{StaticResource AccentBright}" />
                </Border>
            </StackPanel>

            <!-- Release notes -->
            <TextBlock Text="What's new" FontSize="11" FontWeight="Bold" Margin="2,18,0,6"
                       Foreground="{StaticResource TextFaint}" />
            <Border Background="{StaticResource Glass2}" BorderBrush="{StaticResource Line1}"
                    BorderThickness="1" CornerRadius="9" Padding="12,10">
                <ScrollViewer MaxHeight="230" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="NotesText" TextWrapping="Wrap" Foreground="{StaticResource TextDim}"
                               FontSize="12.5" LineHeight="19" />
                </ScrollViewer>
            </Border>

            <!-- Download progress (hidden until installing) -->
            <StackPanel x:Name="ProgressArea" Visibility="Collapsed" Margin="2,16,2,0">
                <TextBlock x:Name="ProgressText" FontSize="12" Foreground="{StaticResource TextMuted}"
                           Margin="0,0,0,6" Text="Downloading update…" />
                <ProgressBar x:Name="Progress" Height="8" Minimum="0" Maximum="1"
                             Background="{StaticResource Glass3}" Foreground="{StaticResource AccentBright}"
                             BorderThickness="0" />
            </StackPanel>

            <!-- Buttons -->
            <StackPanel x:Name="ButtonRow" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button x:Name="SkipButton" Content="Skip this version" Style="{StaticResource DialogButton}"
                        Foreground="{StaticResource TextMuted}" Click="Skip_Click" Margin="0,0,8,0" />
                <Button x:Name="LaterButton" Content="Later" Style="{StaticResource DialogButton}"
                        IsCancel="True" Click="Later_Click" Margin="0,0,8,0" />
                <Button x:Name="UpdateButton" Content="Update now" Style="{StaticResource PrimaryButton}"
                        IsDefault="True" Click="Update_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
