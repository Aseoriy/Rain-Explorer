<Window
    x:Class="RainExplorer.Views.GitChangesWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="1040" Height="760" MinWidth="820" MinHeight="600"
    WindowStyle="None" AllowsTransparency="True" Background="#FF16161F"
    ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterOwner"
    ShowInTaskbar="False" FontFamily="{DynamicResource AppFont}"
    FontSize="13" Foreground="{StaticResource Text}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="RowTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <DataTemplate x:Key="GitFileTemplate">
            <Grid Margin="4,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="94" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{StaticResource AccentWash}"
                        BorderBrush="{StaticResource AccentLine}" BorderThickness="1"
                        CornerRadius="5" Padding="6,2" Margin="0,0,8,0">
                    <TextBlock Text="{Binding ChangeText}" FontSize="10"
                               Foreground="{StaticResource AccentBright}"
                               HorizontalAlignment="Center" />
                </Border>
                <TextBlock Grid.Column="1" Text="{Binding Path}"
                           FontFamily="{StaticResource MonoFont}" FontSize="11"
                           Foreground="{StaticResource Text}" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>
        <Style x:Key="GitList" TargetType="ListBox">
            <Setter Property="Background" Value="{StaticResource Glass2}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line1}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="SelectionMode" Value="Extended" />
            <Setter Property="ItemTemplate" Value="{StaticResource GitFileTemplate}" />
            <Setter Property="MaxHeight" Value="210" />
        </Style>
        <Style x:Key="GitSection" TargetType="Expander">
            <Setter Property="Margin" Value="0,0,0,9" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Border Background="#FF1D1D27" BorderBrush="{StaticResource Line1}"
                                BorderThickness="1" CornerRadius="9">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ToggleButton x:Name="HeaderToggle" Focusable="False"
                                              Content="{TemplateBinding Header}"
                                              IsChecked="{Binding IsExpanded, Mode=TwoWay,
                                                  RelativeSource={RelativeSource TemplatedParent}}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="HeaderBackground" Background="Transparent"
                                                    CornerRadius="8" Padding="12,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <ContentPresenter VerticalAlignment="Center" />
                                                    <Path Grid.Column="1" Style="{StaticResource IconPath}"
                                                          Data="{StaticResource Ic.chevron-down}"
                                                          Stroke="{StaticResource TextMuted}" Width="14" Height="14"
                                                          Margin="12,0,0,0" />
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="HeaderBackground" Property="Background"
                                                            Value="{StaticResource Glass3}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <ContentPresenter x:Name="Content" Grid.Row="1" ContentSource="Content"
                                                  Margin="10,0,10,10" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="Content" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="GitRemoteTemplate">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Name}" Foreground="{StaticResource Text}" />
                <TextBlock Text="  ·  " Foreground="{StaticResource TextFaint}" />
                <TextBlock Text="{Binding DisplayUrl}" Foreground="{StaticResource TextMuted}"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="GitBranchTemplate">
            <TextBlock Text="{Binding DisplayName}" Foreground="{StaticResource Text}" />
        </DataTemplate>
    </Window.Resources>

    <Border Background="#FF16161F" BorderBrush="{StaticResource Line2}"
            BorderThickness="1" CornerRadius="13">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderBrush="{StaticResource Line1}" BorderThickness="0,0,0,1"
                    Padding="18,13" MouseLeftButtonDown="Title_Drag">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="{Binding RepositoryName}" FontSize="18" FontWeight="Bold" />
                        <TextBlock Text="{Binding RepositoryPath}" Margin="0,3,0,0"
                                   FontFamily="{StaticResource MonoFont}" FontSize="11"
                                   Foreground="{StaticResource TextMuted}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Refresh" Style="{StaticResource GhostButton}"
                                Margin="0,0,8,0" Click="Refresh_Click" />
                        <Button Content="Cancel operation" Style="{StaticResource GhostButton}"
                                Margin="0,0,8,0" IsEnabled="{Binding CanCancel}"
                                Click="CancelOperation_Click" />
                        <Button Content="Close" Style="{StaticResource DialogButton}"
                                Click="Close_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1" Background="{StaticResource Glass2}" Padding="18,10"
                    BorderBrush="{StaticResource Line1}" BorderThickness="0,0,0,1">
                <Grid>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding BranchText}" FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentBright}" />
                        <TextBlock Text="  ·  " Foreground="{StaticResource TextFaint}" />
                            <TextBlock Text="{Binding TrackingText}" Foreground="{StaticResource TextMuted}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,9,0,0"
                                    ToolTip="{Binding BranchManagementHint}">
                            <ComboBox x:Name="BranchBox" Width="190"
                                      ItemsSource="{Binding Branches}"
                                      SelectedItem="{Binding SelectedBranch, Mode=TwoWay}"
                                      ItemTemplate="{StaticResource GitBranchTemplate}"
                                      ToolTip="Local branch" />
                            <Button Content="Switch" Style="{StaticResource DialogButton}"
                                    MinWidth="0" Padding="11,6" Margin="7,0,0,0"
                                    IsEnabled="{Binding CanSwitchBranch}"
                                    Click="SwitchBranch_Click" />
                            <Button Content="New…" Style="{StaticResource DialogButton}"
                                    MinWidth="0" Padding="11,6" Margin="7,0,0,0"
                                    IsEnabled="{Binding CanCreateBranch}"
                                    Click="NewBranch_Click" />
                            <Button Content="Delete" Style="{StaticResource GhostButton}"
                                    MinWidth="0" Padding="11,6" Margin="7,0,0,0"
                                    IsEnabled="{Binding CanDeleteBranch}"
                                    Click="DeleteBranch_Click" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom">
                        <TextBlock Text="Push remote" Foreground="{StaticResource TextFaint}"
                                   FontSize="11" Margin="3,0,0,5" />
                        <StackPanel Orientation="Horizontal">
                            <ComboBox x:Name="RemoteBox" Width="250" Margin="0,0,8,0"
                                      ItemsSource="{Binding Remotes}"
                                      SelectedItem="{Binding SelectedRemote, Mode=TwoWay}"
                                      ItemTemplate="{StaticResource GitRemoteTemplate}"
                                      ToolTip="Push remote" />
                            <Button Content="Open on GitHub" Style="{StaticResource GhostButton}"
                                    IsEnabled="{Binding HasGitHubRemote}" Click="OpenGitHub_Click" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="2" Margin="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="340" />
                </Grid.ColumnDefinitions>

                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Background="#FF1D1D27" BorderBrush="{StaticResource Line1}"
                                BorderThickness="1" CornerRadius="9" Padding="26"
                                Visibility="{Binding HasNoFileEntries, Converter={StaticResource BoolToVis}}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="No file changes" FontSize="17" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="Your working tree is clean. Make a change, then refresh this view."
                                           Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"
                                           TextAlignment="Center" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>

                        <Expander Style="{StaticResource GitSection}" IsExpanded="True"
                                  Visibility="{Binding HasConflicts, Converter={StaticResource BoolToVis}}">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Conflicts" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Conflicts.Count, StringFormat= ({0})}"
                                               Foreground="{StaticResource Danger}" Margin="6,0,0,0" />
                                </StackPanel>
                            </Expander.Header>
                            <StackPanel>
                                <ListBox x:Name="ConflictList" Style="{StaticResource GitList}"
                                         ItemsSource="{Binding Conflicts}" />
                                <Button Content="Stage selected resolutions"
                                        Tag="conflicts"
                                        Style="{StaticResource GhostButton}"
                                        HorizontalAlignment="Left" Margin="0,7,0,0"
                                        Click="Stage_Click" />
                            </StackPanel>
                        </Expander>

                        <Expander Style="{StaticResource GitSection}" IsExpanded="True"
                                  Visibility="{Binding HasStagedFiles, Converter={StaticResource BoolToVis}}">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Staged changes" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Staged.Count, StringFormat= ({0})}"
                                               Foreground="{StaticResource AccentBright}" Margin="6,0,0,0" />
                                </StackPanel>
                            </Expander.Header>
                            <StackPanel>
                                <ListBox x:Name="StagedList" Style="{StaticResource GitList}"
                                         ItemsSource="{Binding Staged}" />
                                <Button Content="Unstage selected" Style="{StaticResource GhostButton}"
                                        HorizontalAlignment="Left" Margin="0,7,0,0"
                                        Click="Unstage_Click" />
                            </StackPanel>
                        </Expander>

                        <Expander Style="{StaticResource GitSection}" IsExpanded="True"
                                  Visibility="{Binding HasUnstagedFiles, Converter={StaticResource BoolToVis}}">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Unstaged changes" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Unstaged.Count, StringFormat= ({0})}"
                                               Foreground="{StaticResource TextMuted}" Margin="6,0,0,0" />
                                </StackPanel>
                            </Expander.Header>
                            <StackPanel>
                                <ListBox x:Name="UnstagedList" Style="{StaticResource GitList}"
                                         ItemsSource="{Binding Unstaged}" />
                                <Button Content="Stage selected" Tag="unstaged"
                                        Style="{StaticResource GhostButton}"
                                        HorizontalAlignment="Left" Margin="0,7,0,0"
                                        Click="Stage_Click" />
                            </StackPanel>
                        </Expander>

                        <Expander Style="{StaticResource GitSection}" IsExpanded="True"
                                  Visibility="{Binding HasUntrackedFiles, Converter={StaticResource BoolToVis}}">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Untracked files" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Untracked.Count, StringFormat= ({0})}"
                                               Foreground="{StaticResource TextMuted}" Margin="6,0,0,0" />
                                </StackPanel>
                            </Expander.Header>
                            <StackPanel>
                                <ListBox x:Name="UntrackedList" Style="{StaticResource GitList}"
                                         ItemsSource="{Binding Untracked}" />
                                <Button Content="Stage selected" Tag="untracked"
                                        Style="{StaticResource GhostButton}"
                                        HorizontalAlignment="Left" Margin="0,7,0,0"
                                        Click="Stage_Click" />
                            </StackPanel>
                        </Expander>

                        <Expander Style="{StaticResource GitSection}" IsExpanded="False"
                                  Visibility="{Binding HasIgnoredFiles, Converter={StaticResource BoolToVis}}">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Ignored entries" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Ignored.Count, StringFormat= ({0})}"
                                               Foreground="{StaticResource TextFaint}" Margin="6,0,0,0" />
                                </StackPanel>
                            </Expander.Header>
                            <ListBox x:Name="IgnoredList" Style="{StaticResource GitList}"
                                     ItemsSource="{Binding Ignored}" />
                        </Expander>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Column="2" Background="{StaticResource Glass2}"
                        BorderBrush="{StaticResource Line1}" BorderThickness="1"
                        CornerRadius="10" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0">
                            <TextBlock Text="Create a local commit" FontSize="16" FontWeight="Bold" />
                            <TextBlock Text="This records the staged changes on this PC. It does not upload anything."
                                       Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"
                                       Margin="0,5,0,12" />
                            <TextBlock Text="{Binding StagedSummary}" Foreground="{StaticResource AccentBright}" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Margin="0,14,0,0">
                            <TextBlock Text="Summary" Style="{StaticResource RowTitle}" />
                            <TextBox x:Name="SummaryBox" Style="{StaticResource FieldBox}"
                                     Height="34" MaxLength="200" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Margin="0,13,0,0">
                            <TextBlock Text="Description (optional)" Style="{StaticResource RowTitle}" />
                            <TextBox x:Name="DescriptionBox" Style="{StaticResource FieldBox}"
                                     Margin="0,6,0,0" AcceptsReturn="True"
                                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                     MinHeight="112" VerticalAlignment="Top" />
                        </StackPanel>

                        <Button Grid.Row="3" Content="Commit locally" Style="{StaticResource PrimaryButton}"
                                Margin="0,14,0,0" IsEnabled="{Binding CanCommit}"
                                Click="Commit_Click" />

                        <Button Grid.Row="4" Content="{Binding PushButtonText}"
                                Style="{StaticResource DialogButton}" Margin="0,9,0,0"
                                IsEnabled="{Binding CanPush}" Click="Push_Click" />
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="3" Background="{StaticResource Glass2}"
                    BorderBrush="{StaticResource Line1}" BorderThickness="0,1,0,0"
                    Padding="16,9">
                <TextBlock Text="{Binding Message}" Foreground="{StaticResource TextMuted}"
                           TextWrapping="Wrap" />
            </Border>
        </Grid>
    </Border>
</Window>
