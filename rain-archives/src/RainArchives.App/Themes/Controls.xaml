                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="PART_Indicator" Property="Background" Value="{DynamicResource DisabledTextBrush}" />
                            <Setter TargetName="BusySegment0" Property="Background" Value="{DynamicResource DisabledTextBrush}" />
                            <Setter TargetName="BusySegment1" Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
                            <Setter TargetName="BusySegment2" Property="Background" Value="{DynamicResource DisabledTextBrush}" />
                            <Setter TargetName="BusySegment3" Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
                            <Setter TargetName="BusySegment4" Property="Background" Value="{DynamicResource DisabledTextBrush}" />
