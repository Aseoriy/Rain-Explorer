    <Style x:Key="SemanticProgressBarStyle" TargetType="ProgressBar">
        <Setter Property="MinHeight" Value="4" />
        <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border x:Name="PART_Track"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            SnapsToDevicePixels="True">
                        <Grid x:Name="ProgressRoot" ClipToBounds="True">
                            <Border x:Name="PART_Indicator"
                                    HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="3" />
                            <Grid x:Name="IndeterminateIndicator" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="2*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="BusySegment0" Grid.Column="0" Background="{DynamicResource AccentBrush}" />
                                <Border x:Name="BusySegment1" Grid.Column="1" Background="{DynamicResource AccentWashBrush}" />
                                <Border x:Name="BusySegment2" Grid.Column="2" Background="{DynamicResource AccentHoverBrush}" />
                                <Border x:Name="BusySegment3" Grid.Column="3" Background="{DynamicResource AccentWashBrush}" />
