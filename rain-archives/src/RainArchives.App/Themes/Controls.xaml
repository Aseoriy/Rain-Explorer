    <Style TargetType="TabItem" BasedOn="{StaticResource SemanticTabItemStyle}" />

    <Style x:Key="DataGridColumnHeaderGripperStyle" TargetType="Thumb">
        <Setter Property="Width" Value="8" />
        <Setter Property="Background" Value="Transparent" />
