    <Style TargetType="DataGridRow" BasedOn="{StaticResource SemanticDataGridRowStyle}" />

    <Style x:Key="SemanticDataGridStyle" TargetType="DataGrid">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource SurfaceForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
