<Window x:Class="RainArchives.App.Views.SettingsCenterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings and Presets"
        Width="1040"
        Height="780"
        MinWidth="760"
        MinHeight="560"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource BackgroundForegroundBrush}"
        WindowStartupLocation="CenterOwner"
        AutomationProperties.Name="Rain Archives Settings and Presets"
        AutomationProperties.HelpText="Manage bounded local UI defaults and ZIP presets without storing archive paths or Worker authority.">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource SecondaryWindowTitleStyle}"
                           Text="Settings and Presets" />
                <TextBlock Margin="0,5,0,0"
                           Style="{StaticResource SecondaryWindowSecondaryTextStyle}"
                           Text="Choose managed-format defaults and reusable ZIP presets. Every value is revalidated against authenticated Worker capabilities before use." />
            </StackPanel>
            <Button Grid.Column="1"
                    KeyboardNavigation.TabIndex="0"
                    Command="{Binding RefreshCommand}"
                    Content="_Refresh capabilities"
                    AutomationProperties.Name="Refresh managed format capabilities"
                    AutomationProperties.HelpText="Request one non-overlapping authenticated capability refresh without accessing an archive path." />
        </Grid>

        <ScrollViewer x:Name="SettingsContentScroll"
                      Grid.Row="1"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      CanContentScroll="False"
                      HorizontalContentAlignment="Stretch"
                      PanningMode="VerticalOnly"
                      AutomationProperties.Name="Settings content">
            <StackPanel>
                <Border Margin="0,0,0,14" Style="{StaticResource SecondaryCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Style="{StaticResource ShellSectionHeadingStyle}" Text="Local settings state" />
                            <TextBlock Margin="0,6,0,0"
                                       Style="{StaticResource ShellSecondaryTextStyle}"
                                       AutomationProperties.Name="Local settings status"
                                       Text="{Binding PersistenceStatus}" />
                            <TextBlock Margin="0,5,0,0"
                                       Style="{StaticResource ShellSecondaryTextStyle}"
                                       AutomationProperties.Name="ZIP preset storage status"
                                       Text="{Binding PresetStatus}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                            <TextBlock Style="{StaticResource ShellSectionHeadingStyle}" Text="Worker capability state" />
                            <TextBlock Margin="0,6,0,0"
                                       Style="{StaticResource ShellSecondaryTextStyle}"
                                       AutomationProperties.Name="Authenticated Worker capability status"
                                       Text="{Binding CapabilityStatus}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Margin="0,0,0,14" Style="{StaticResource SecondaryCardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource ShellSectionHeadingStyle}" Text="Managed creation defaults" />
                        <TextBlock Margin="0,4,0,12"
                                   Style="{StaticResource ShellSecondaryTextStyle}"
                                   Text="Defaults are hints only. The Create review and operation start both check the current format, preset, source shape, count, byte, and directory capability again." />
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="280" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0"
                                   Target="{Binding ElementName=DefaultFormatInput}"
                                   Content="_Default creation format" />
                            <ComboBox x:Name="DefaultFormatInput"
                                      Grid.Column="1"
                                      KeyboardNavigation.TabIndex="1"
                                      ItemsSource="{Binding Formats}"
                                      SelectedItem="{Binding SelectedDefaultFormat}"
                                      DisplayMemberPath="Name"
                                      IsEnabled="{Binding CanEditDefaults}"
                                      AutomationProperties.Name="Default managed archive format"
                                      AutomationProperties.HelpText="Only a format advertised by the current authenticated Worker can be selected." />
                            <TextBlock Grid.Column="2"
                                       Margin="14,0,0,0"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource ShellSecondaryTextStyle}"
                                       Text="Unsupported and downgraded formats remain visible but cannot be selected as current capability." />
                        </Grid>

                        <DataGrid x:Name="FormatDefaultsGrid"
                                  Style="{StaticResource SecondaryDataGridStyle}"
                                  MinHeight="180"
                                  MaxHeight="290"
                                  KeyboardNavigation.TabIndex="2"
                                  ItemsSource="{Binding Formats}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  EnableRowVirtualization="True"
                                  EnableColumnVirtualization="True"
                                  HeadersVisibility="Column"
                                  IsReadOnly="False"
                                  IsEnabled="{Binding CanEditDefaults}"
                                  ScrollViewer.CanContentScroll="True"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  AutomationProperties.Name="Managed format preset defaults"
                                  AutomationProperties.HelpText="Six bounded managed format defaults with current capability and source constraints.">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Format" Binding="{Binding Name}" IsReadOnly="True" Width="90" />
                                <DataGridTemplateColumn Header="Default preset" Width="170">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox Margin="3"
                                                      ItemsSource="{Binding Presets}"
                                                      SelectedItem="{Binding SelectedPreset}"
                                                      DisplayMemberPath="Name"
                                                      IsEnabled="{Binding IsSupported}"
                                                      AutomationProperties.Name="{Binding Name, StringFormat={}{0} default compression preset}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Current capability" Binding="{Binding AvailabilityText}" IsReadOnly="True" Width="240" />
                                <DataGridTemplateColumn Header="Source constraints" IsReadOnly="True" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Margin="8,5"
                                                       VerticalAlignment="Center"
                                                       Text="{Binding ConstraintText}"
                                                       TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="280" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0"
                                   Target="{Binding ElementName=RebuildPresetInput}"
                                   Content="ZIP Rebuild Copy _preset" />
                            <ComboBox x:Name="RebuildPresetInput"
                                      Grid.Column="1"
                                      KeyboardNavigation.TabIndex="3"
                                      ItemsSource="{Binding ZipRebuildPresets}"
                                      SelectedItem="{Binding ZipRebuildPreset}"
                                      DisplayMemberPath="Name"
                                      IsEnabled="{Binding CanEditDefaults}"
                                      AutomationProperties.Name="Eligible ZIP rebuild copy default preset"
                                      AutomationProperties.HelpText="This hint is available only to an eligible current ZIP session and is checked again before rebuilding." />
                            <TextBlock Grid.Column="2"
                                       Margin="14,0,0,0"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource ShellSecondaryTextStyle}"
                                       Text="Rebuild always writes a distinct absent copy; the original archive remains untouched." />
                        </Grid>

                        <CheckBox Margin="0,12,0,0"
                                  KeyboardNavigation.TabIndex="4"
                                  IsChecked="{Binding ShowAdvancedRebuildOptions}"
                                  IsEnabled="{Binding CanEditLocalPreferences}"
                                  Content="Show ad_vanced metadata review by default for eligible ZIP rebuilds"
                                  AutomationProperties.Name="Show advanced ZIP rebuild metadata review by default" />
                    </StackPanel>
                </Border>

                <Border Margin="0,0,0,14" Style="{StaticResource SecondaryCardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource ShellSectionHeadingStyle}" Text="Reusable ZIP presets" />
                        <TextBlock Margin="0,4,0,10"
                                   Style="{StaticResource ShellSecondaryTextStyle}"
                                   Text="Up to 64 user presets are stored with a 64-scalar, 256-byte NFC name and optional DOS-representable mapped-entry metadata defaults. Built-ins remain immutable." />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.1*" />
                                <ColumnDefinition Width="1.4*" />
                            </Grid.ColumnDefinitions>
                            <DataGrid x:Name="PresetGrid"
                                      Style="{StaticResource SecondaryDataGridStyle}"
                                      Grid.Column="0"
                                      MinHeight="180"
                                      MaxHeight="260"
                                      KeyboardNavigation.TabIndex="5"
                                      ItemsSource="{Binding UserPresets}"
                                      SelectedItem="{Binding SelectedUserPreset}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      EnableRowVirtualization="True"
                                      EnableColumnVirtualization="True"
                                      HeadersVisibility="Column"
                                      IsReadOnly="True"
                                      ScrollViewer.CanContentScroll="True"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      SelectionMode="Single"
                                      SelectionUnit="FullRow"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling"
                                      AutomationProperties.Name="User ZIP preset list">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                                    <DataGridTextColumn Header="Compression" Binding="{Binding Compression}" Width="110" />
                                    <DataGridTextColumn Header="Metadata" Binding="{Binding MetadataSummary}" Width="190" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <Grid x:Name="PresetEditorGrid" Grid.Column="1" Margin="16,0,0,0" IsEnabled="{Binding CanEditPresets}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Label Grid.Row="0" Target="{Binding ElementName=PresetNameInput}" Content="Preset _name" />
                                <TextBox x:Name="PresetNameInput"
                                         Grid.Row="0"
                                         Grid.Column="1"
                                         KeyboardNavigation.TabIndex="6"
                                         MaxLength="128"
                                         Text="{Binding PresetName, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="ZIP preset name"
                                         AutomationProperties.HelpText="The store enforces NFC, Unicode scalar, UTF-8 byte, control-character, uniqueness, and built-in shadowing bounds." />
                                <Label Grid.Row="1" Target="{Binding ElementName=PresetCompressionInput}" Content="_Compression" />
                                <ComboBox x:Name="PresetCompressionInput"
                                          Grid.Row="1"
                                          Grid.Column="1"
                                          KeyboardNavigation.TabIndex="7"
                                          ItemsSource="{Binding CompressionPresets}"
                                          SelectedItem="{Binding PresetCompression}"
                                          DisplayMemberPath="Name"
                                          AutomationProperties.Name="ZIP preset compression" />
                                <Label Grid.Row="2" Target="{Binding ElementName=PresetTimeInput}" Content="Default _time" />
                                <TextBox x:Name="PresetTimeInput"
                                         Grid.Row="2"
                                         Grid.Column="1"
                                         KeyboardNavigation.TabIndex="8"
                                         Text="{Binding PresetTime, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="ZIP preset default archive time"
                                         AutomationProperties.HelpText="Optional exact local archive tuple YYYY-MM-DDTHH:mm:ss with even seconds from 1980 through 2107." />
                                <Label Grid.Row="3" Target="{Binding ElementName=PresetAttributesInput}" Content="Default attr_ibutes" />
                                <TextBox x:Name="PresetAttributesInput"
                                         Grid.Row="3"
                                         Grid.Column="1"
                                         KeyboardNavigation.TabIndex="9"
                                         Text="{Binding PresetAttributes, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="ZIP preset default attributes"
                                         AutomationProperties.HelpText="Optional ReadOnly, Hidden, System, Archive names, decimal value, or 0x hexadecimal low word." />
                                <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Margin="0,10,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button KeyboardNavigation.TabIndex="10"
                                            Command="{Binding AddOrUpdatePresetCommand}"
                                            Content="_Add or update"
                                            AutomationProperties.Name="Add or update user ZIP preset"
                                            AutomationProperties.HelpText="Validate and atomically save this bounded local user preset without storing archive paths or Worker authority." />
                                    <Button KeyboardNavigation.TabIndex="11"
                                            Command="{Binding RemovePresetCommand}"
                                            Content="Remove se_lected"
                                            AutomationProperties.Name="Remove selected user ZIP preset"
                                            AutomationProperties.HelpText="Remove the selected user preset. Built-in presets remain immutable." />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Margin="0,0,0,14" Style="{StaticResource SecondaryCardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource ShellSectionHeadingStyle}" Text="Safety and privacy boundary" />
                        <TextBlock Margin="0,6,0,0"
                                   TextWrapping="Wrap"
                                   Text="Rain stores no archive source or destination paths, entry names or text, passwords or secret slots, recovery identifiers or revisions, operation history, provider or exception text, temporary paths, filesystem identities, handles, or Worker authority in these settings." />
                        <TextBlock Margin="0,6,0,0"
                                   Style="{StaticResource ShellSecondaryTextStyle}"
                                   Text="Encryption, filename encryption, split volumes, overwrite or replacement, retry, pause, reorder, decision continuation, in-place update, native 7z, and XZ creation remain unavailable. RAR creation requires a separately installed, verified WinRAR 7.23 or later encoder and a protocol-1.23 client surface. Existing or raced destinations are preserved." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="SettingsStatusAnnouncement"
                       VerticalAlignment="Center"
                       Margin="0,0,14,0"
                       TextWrapping="Wrap"
                       AutomationProperties.Name="Settings Center live status"
                       AutomationProperties.LiveSetting="Polite"
                       Text="{Binding StatusAnnouncement}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="ResetButton"
                        KeyboardNavigation.TabIndex="12"
                        Command="{Binding ResetCommand}"
                        Content="Reset all"
                        AutomationProperties.Name="Reset UI settings and user ZIP presets"
                        AutomationProperties.HelpText="Explicitly replace both bounded local documents with defaults and remove user presets. Backups are retained by atomic replacement." />
                <Button x:Name="SaveButton"
                        KeyboardNavigation.TabIndex="13"
                        Command="{Binding SaveCommand}"
                        Content="_Save"
                        IsDefault="True"
                        AutomationProperties.Name="Save settings and presets"
                        AutomationProperties.HelpText="Atomically save each independent bounded local settings document." />
                <Button x:Name="CloseButton"
                        KeyboardNavigation.TabIndex="14"
                        Margin="0"
                        Content="Cl_ose"
                        IsCancel="True"
                        Click="Close_Click"
                        AutomationProperties.Name="Close Settings and Presets"
                        AutomationProperties.HelpText="Close Settings and Presets after any in-flight capability request drains." />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
