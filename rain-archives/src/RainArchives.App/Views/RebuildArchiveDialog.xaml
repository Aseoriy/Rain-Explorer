<Window x:Class="RainArchives.App.Views.RebuildArchiveDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rebuild ZIP copy"
        Width="980"
        Height="760"
        MinWidth="760"
        MinHeight="600"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource BackgroundForegroundBrush}"
        WindowStartupLocation="CenterOwner"
        AutomationProperties.Name="Rebuild ZIP copy"
        AutomationProperties.HelpText="Review bounded deletions, renames, additions, replacements, folder changes, metadata, and a distinct absent destination before rebuilding a copy.">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Style="{StaticResource SecondaryWindowTitleStyle}" Text="Rebuild a ZIP copy" />
            <TextBlock Margin="0,5,0,0"
                       Style="{StaticResource SecondaryWindowSecondaryTextStyle}"
                       Text="Review the persistent entries to delete or rename, add new files, or explicitly replace existing files. Rain streams the result into a new archive." />
        </StackPanel>

        <ScrollViewer x:Name="RebuildContentScroll"
                      Grid.Row="1"
                      HorizontalContentAlignment="Stretch"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      AutomationProperties.Name="Rebuild copy setup content">
            <Grid Margin="0,0,0,4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

        <Grid Grid.Row="0" Height="250">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Margin="0,0,0,7" FontWeight="SemiBold" Text="Persistent entries" />
            <DataGrid x:Name="EntriesGrid"
                      Grid.Row="1"
                      Style="{StaticResource SecondaryDataGridStyle}"
                      KeyboardNavigation.TabIndex="0"
                      AutomationProperties.HelpText="Select persistent archive entries for deletion. Each selection is sent with its normalized path and duplicate ordinal."
                      AutomationProperties.Name="Persistent archive entries"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="True"
                      HeadersVisibility="Column"
                      IsReadOnly="False"
                      ScrollViewer.CanContentScroll="True"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="Delete"
                                            Binding="{Binding IsMarkedForDeletion, UpdateSourceTrigger=PropertyChanged}"
                                            ElementStyle="{StaticResource DataGridCheckBoxElementStyle}"
                                            EditingElementStyle="{StaticResource DataGridCheckBoxEditingElementStyle}"
                                            Width="70" />
                    <DataGridTextColumn Header="Path" Binding="{Binding DisplayPath}" ElementStyle="{StaticResource ArchiveCellTextStyle}" IsReadOnly="True" Width="2*" />
                    <DataGridTextColumn Header="Type" Binding="{Binding Kind}" IsReadOnly="True" Width="100" />
                    <DataGridTextColumn Header="Duplicate" Binding="{Binding DuplicateOrdinal}" IsReadOnly="True" Width="90" />
                    <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" IsReadOnly="True" Width="110" />
                    <DataGridTemplateColumn Header="Rename to" Width="2*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayRenamePath}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <TextBox AutomationProperties.HelpText="Enter a final archive-relative file path to rename this retained regular file. Leave blank to keep its original path."
                                         AutomationProperties.Name="Retained archive entry rename path"
                                         Text="{Binding RenamePath, UpdateSourceTrigger=PropertyChanged}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <DockPanel Grid.Row="1" Margin="0,14,0,7">
            <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" FontWeight="SemiBold" Text="New, replacement, and rename operations" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="AddFilesButton"
                        Margin="8,0,0,0"
                        KeyboardNavigation.TabIndex="1"
                        AutomationProperties.HelpText="Choose files to add to the rebuilt ZIP. Their archive paths can be edited below."
                        AutomationProperties.Name="Add files to rebuilt ZIP"
                        Click="AddFiles_Click"
                        Content="_Add files" />
                <Button x:Name="ReplaceFileButton"
                        Margin="8,0,0,0"
                        KeyboardNavigation.TabIndex="2"
                        AutomationProperties.HelpText="Replace the selected persistent file with a chosen source file while keeping its exact archive path."
                        AutomationProperties.Name="Replace selected archive file"
                        Click="ReplaceFile_Click"
                        Content="Re_place selected" />
                <Button x:Name="RemoveFileButton"
                        Margin="8,0,0,0"
                        KeyboardNavigation.TabIndex="3"
                        AutomationProperties.Name="Remove selected rebuild input"
                        AutomationProperties.HelpText="Remove the selected new or replacement input without changing its source file."
                        Click="RemoveFile_Click"
                        Content="Re_move"
                        IsEnabled="False" />
            </StackPanel>
        </DockPanel>

        <DataGrid x:Name="FilesGrid"
                  Grid.Row="2"
                  Height="160"
                  Style="{StaticResource SecondaryDataGridStyle}"
                  KeyboardNavigation.TabIndex="4"
                  AutomationProperties.HelpText="New files and explicit replacements for the rebuilt ZIP. Rename operations are reviewed in the persistent entries table above; this table distinguishes Add from Replace. Edit archive paths for additions; replacement paths are fixed to the selected persistent entry."
                  AutomationProperties.Name="Rebuild ZIP file inputs"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  EnableRowVirtualization="True"
                  EnableColumnVirtualization="True"
                  HeadersVisibility="Column"
                  IsReadOnly="False"
                  ScrollViewer.CanContentScroll="True"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Mode" Binding="{Binding Mode}" IsReadOnly="True" Width="110" />
                <DataGridTemplateColumn Header="Archive path" Width="2*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayArchivePath}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <TextBox IsReadOnly="{Binding IsReplacement}"
                                     AutomationProperties.Name="New or replacement archive path"
                                     AutomationProperties.HelpText="Edit the final archive-relative path for an addition. Replacement paths remain fixed to the selected persistent entry."
                                     Text="{Binding ArchivePath, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Source file" Binding="{Binding DisplaySourcePath}" ElementStyle="{StaticResource ArchiveCellTextStyle}" IsReadOnly="True" Width="3*" />
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="3" Margin="0,14,0,7">
            <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" FontWeight="SemiBold" Text="Worker-returned tree plan" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="AddFolderButton"
                        Margin="8,0,0,0"
                        KeyboardNavigation.TabIndex="5"
                        AutomationProperties.Name="Add folder to rebuilt ZIP"
                        AutomationProperties.HelpText="Choose one folder for bounded Worker enumeration into the rebuilt copy."
                        Click="AddFolder_Click"
                        Content="Add _folder" />
                <Button x:Name="RemoveFolderButton"
                        Margin="8,0,0,0"
                        KeyboardNavigation.TabIndex="6"
                        AutomationProperties.Name="Remove selected folder input"
                        AutomationProperties.HelpText="Remove the selected folder addition without changing the source folder."
                        Click="RemoveFolder_Click"
                        Content="Remove fol_der" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="4" Height="170">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>
            <DataGrid x:Name="TreePlanGrid"
                      Grid.Column="0"
                      Style="{StaticResource SecondaryDataGridStyle}"
                      KeyboardNavigation.TabIndex="7"
                      AutomationProperties.Name="Worker returned ZIP tree plan"
                      AutomationProperties.HelpText="Worker-returned bounded folder plan. Review explicit folder deletions and final move prefixes before rebuilding."
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="True"
                      HeadersVisibility="Column"
                      ScrollViewer.CanContentScroll="True"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="Delete"
                                            Binding="{Binding IsMarkedForDeletion, UpdateSourceTrigger=PropertyChanged}"
                                            ElementStyle="{StaticResource DataGridCheckBoxElementStyle}"
                                            EditingElementStyle="{StaticResource DataGridCheckBoxEditingElementStyle}"
                                            Width="60" />
                    <DataGridTextColumn Header="Folder" Binding="{Binding DisplayPath}" ElementStyle="{StaticResource ArchiveCellTextStyle}" IsReadOnly="True" Width="2*" />
                    <DataGridTextColumn Header="Descendants" Binding="{Binding DescendantCount}" IsReadOnly="True" Width="95" />
                    <DataGridTextColumn Header="Material" Binding="{Binding MaterialEntryCount}" IsReadOnly="True" Width="80" />
                    <DataGridTemplateColumn Header="Move prefix" Width="2*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayMovePrefix}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <TextBox AutomationProperties.Name="Folder move prefix"
                                         AutomationProperties.HelpText="Enter the final archive-relative prefix for this Worker-returned folder plan node."
                                         Text="{Binding MovePrefix, UpdateSourceTrigger=PropertyChanged}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            <DataGrid x:Name="FolderAddsGrid"
                      Grid.Column="1"
                      Margin="10,0,0,0"
                      Style="{StaticResource SecondaryDataGridStyle}"
                      KeyboardNavigation.TabIndex="8"
                      AutomationProperties.Name="ZIP folder additions"
                      AutomationProperties.HelpText="Bounded folder additions returned from Worker enumeration. Review each escaped source and editable archive root."
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="True"
                      HeadersVisibility="Column"
                      ScrollViewer.CanContentScroll="True"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Source folder" Binding="{Binding DisplaySourcePath}" ElementStyle="{StaticResource ArchiveCellTextStyle}" IsReadOnly="True" Width="2*" />
                    <DataGridTemplateColumn Header="Archive root" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayArchiveRoot}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <TextBox AutomationProperties.Name="Folder addition archive root"
                                         AutomationProperties.HelpText="Enter the final archive-relative root for this bounded folder addition."
                                         Text="{Binding ArchiveRoot, UpdateSourceTrigger=PropertyChanged}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Bounded review" Binding="{Binding CountText}" IsReadOnly="True" Width="1.5*" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <Grid Grid.Row="5" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Margin="0,0,0,5" FontWeight="SemiBold" Text="New destination" />
                <TextBox x:Name="DestinationInput"
                         KeyboardNavigation.TabIndex="9"
                         AutomationProperties.HelpText="Enter a fully qualified, absent ZIP path. It must differ from the original archive and every new source file."
                         AutomationProperties.Name="New rebuilt ZIP destination"
                         TextChanged="DestinationInput_TextChanged" />
            </StackPanel>
            <Button x:Name="BrowseDestinationButton"
                    Grid.Column="1"
                    Margin="10,25,0,0"
                    KeyboardNavigation.TabIndex="10"
                    AutomationProperties.Name="Browse for rebuilt ZIP destination"
                    AutomationProperties.HelpText="Choose a distinct absent ZIP destination. The original and all source files remain untouched."
                    Click="BrowseDestination_Click"
                    Content="_Browse" />
        </Grid>

        <Grid Grid.Row="6" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
            <TextBlock Margin="0,0,0,5" FontWeight="SemiBold" Text="Compression preset" />
                <ComboBox x:Name="PresetInput"
                          MinHeight="34"
                          KeyboardNavigation.TabIndex="11"
                          AutomationProperties.HelpText="Choose Store, Fast, Balanced, or Maximum compression for the rebuilt copy."
                          AutomationProperties.Name="Rebuild ZIP compression preset"
                          DisplayMemberPath="Name" />
                <TextBox x:Name="PresetNameInput"
                         Margin="0,6,0,0"
                         KeyboardNavigation.TabIndex="12"
                         AutomationProperties.Name="New rebuild ZIP preset name"
                         AutomationProperties.HelpText="Optional bounded name for a reusable local rebuild preset."
                         ToolTip="Optional name for a reusable user preset" />
                <TextBox x:Name="PresetDefaultTimeInput"
                         Margin="0,4,0,0"
                         KeyboardNavigation.TabIndex="13"
                         AutomationProperties.Name="Rebuild preset default archive time"
                         AutomationProperties.HelpText="Optional exact local archive tuple YYYY-MM-DDTHH:mm:ss with even seconds from 1980 through 2107."
                         ToolTip="Optional exact YYYY-MM-DDTHH:mm:ss default for mapped entries" />
                <TextBox x:Name="PresetDefaultAttributesInput"
                         Margin="0,4,0,0"
                         KeyboardNavigation.TabIndex="14"
                         AutomationProperties.Name="Rebuild preset default attributes"
                         AutomationProperties.HelpText="Optional ReadOnly, Hidden, System, Archive names, decimal value, or 0x hexadecimal low word."
                         ToolTip="Optional ReadOnly, Hidden, System, Archive defaults for mapped entries" />
                <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                    <Button x:Name="SavePresetButton"
                            KeyboardNavigation.TabIndex="15"
                            AutomationProperties.Name="Save rebuild ZIP preset"
                            AutomationProperties.HelpText="Save this bounded local ZIP preset without storing archive paths or Worker authority."
                            Click="SavePreset_Click"
                            Content="_Save" />
                    <Button x:Name="RemovePresetButton"
                            Margin="6,0,0,0"
                            KeyboardNavigation.TabIndex="16"
                            AutomationProperties.Name="Remove rebuild ZIP preset"
                            AutomationProperties.HelpText="Remove the selected reusable user preset. Built-in presets remain immutable."
                            Click="RemovePreset_Click"
                            Content="Remo_ve preset" />
                </StackPanel>
            </StackPanel>
            <TextBlock Grid.Column="1"
                       Margin="18,25,0,0"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource BackgroundSecondaryForegroundBrush}"
                       Text="The original archive remains untouched. The destination is created only as a new copy."
                       TextWrapping="Wrap" />
            <TextBlock x:Name="PresetWarningText"
                       Grid.Column="1"
                       Margin="18,52,0,0"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource BackgroundSecondaryForegroundBrush}"
                       TextWrapping="Wrap" />
        </Grid>

        <Expander x:Name="AdvancedMetadataExpander"
                  Grid.Row="7"
                  Margin="0,14,0,0"
                  KeyboardNavigation.TabIndex="17"
                  AutomationProperties.Name="Advanced ZIP metadata review"
                  AutomationProperties.HelpText="Expand a bounded, scrollable review of current and final ZIP-local time and attribute fields."
                  Header="Advanced metadata review"
                  IsExpanded="False">
            <ScrollViewer MaxHeight="260"
                          Margin="0,8,0,0"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          AutomationProperties.Name="Scrollable advanced ZIP metadata review">
                <StackPanel>
                <StackPanel Margin="0,0,0,6">
                    <TextBlock FontWeight="SemiBold" Text="Archive time (timezone unavailable)" />
                    <TextBlock Margin="0,2,0,0"
                               Foreground="{DynamicResource BackgroundSecondaryForegroundBrush}"
                               Text="Review current and final values before confirmation. Provider comments and extra fields are not preserved."
                               TextWrapping="Wrap" />
                </StackPanel>
                <DataGrid x:Name="MetadataGrid"
                          Height="150"
                          Style="{StaticResource SecondaryDataGridStyle}"
                          KeyboardNavigation.TabIndex="18"
                          AutomationProperties.HelpText="Review current and final archive metadata. Enter exact YYYY-MM-DDTHH:mm:ss values with even seconds, or leave blank to use Rain's derived rebuild value. The raw ZIP-local current tuple is unavailable."
                          AutomationProperties.Name="ZIP metadata current and final review"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          EnableRowVirtualization="True"
                          EnableColumnVirtualization="True"
                          HeadersVisibility="Column"
                          IsReadOnly="False"
                          ScrollViewer.CanContentScroll="True"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Target" Binding="{Binding TargetText}" IsReadOnly="True" Width="2*" />
                        <DataGridTextColumn Header="Current time" Binding="{Binding CurrentTimeText}" IsReadOnly="True" Width="1.5*" />
                        <DataGridTextColumn Header="Final time"
                                            Binding="{Binding FinalTimeText, UpdateSourceTrigger=PropertyChanged}"
                                            EditingElementStyle="{StaticResource DataGridTextEditingElementStyle}"
                                            Width="1.5*" />
                        <DataGridTextColumn Header="Current attributes" Binding="{Binding CurrentAttributesText}" IsReadOnly="True" Width="1.2*" />
                        <DataGridTextColumn Header="Final attributes"
                                            Binding="{Binding FinalAttributesText, UpdateSourceTrigger=PropertyChanged}"
                                            EditingElementStyle="{StaticResource DataGridTextEditingElementStyle}"
                                            Width="1.2*" />
                    </DataGrid.Columns>
                </DataGrid>
                </StackPanel>
            </ScrollViewer>
        </Expander>

            </Grid>
        </ScrollViewer>

        <Border Grid.Row="2" Margin="0,14,0,0" Padding="10" Style="{StaticResource SecondaryCardStyle}">
            <StackPanel>
                <TextBlock x:Name="ReviewSummaryText"
                           FontWeight="SemiBold"
                           AutomationProperties.Name="ZIP rebuild final review"
                           AutomationProperties.LiveSetting="Polite"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="DestinationPolicyText"
                           Margin="0,5,0,0"
                           Foreground="{DynamicResource SurfaceSecondaryForegroundBrush}"
                           AutomationProperties.Name="ZIP rebuild destination safety policy"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="ValidationMessage"
                           Margin="0,5,0,0"
                           AutomationProperties.LiveSetting="Assertive"
                           AutomationProperties.Name="Rebuild copy validation message"
                           Foreground="{DynamicResource DangerBrush}"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="OriginalUntouchedText"
                           Margin="0,5,0,0"
                           AutomationProperties.Name="Original archive safety statement"
                            Text="Before you confirm: the original archive remains untouched, and Rain opens the new copy only after the worker reports authoritative success. Rename is distinct from Replace: a rename retains the original file bytes and changes only its final archive path."
                           TextWrapping="Wrap" />
                <StackPanel Margin="0,14,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button x:Name="CancelSetupButton"
                            KeyboardNavigation.TabIndex="19"
                            AutomationProperties.Name="Cancel ZIP rebuild setup"
                            AutomationProperties.HelpText="Close this setup without starting a rebuild operation or changing the original archive."
                            Content="Cancel"
                            IsCancel="True" />
                    <Button x:Name="RebuildCopyButton"
                            Margin="8,0,0,0"
                            KeyboardNavigation.TabIndex="20"
                            AutomationProperties.HelpText="Confirm the reviewed deletions, additions, replacements, preset, and new destination."
                            AutomationProperties.Name="Confirm ZIP rebuild copy"
                            Click="RebuildCopy_Click"
                            Content="_Rebuild copy"
                            IsDefault="True"
                            Style="{StaticResource PrimaryButtonStyle}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
