<Window x:Class="RainArchives.App.Views.PasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Password required"
        Width="460"
        Height="230"
        MinWidth="360"
        MinHeight="220"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource BackgroundForegroundBrush}"
        AutomationProperties.Name="Archive password prompt"
        AutomationProperties.HelpText="Enter a one-shot archive password. Rain clears the visible and captured password when this prompt closes.">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource SecondaryWindowTitleStyle}" Text="This archive is encrypted" />
        <TextBlock x:Name="ArchiveNameText"
                   Grid.Row="1"
                   Margin="0,6,0,14"
                   MaxHeight="36"
                   Style="{StaticResource SecondaryWindowSecondaryTextStyle}"
                   AutomationProperties.Name="Encrypted archive name"
                   TextTrimming="CharacterEllipsis"
                   TextWrapping="NoWrap" />
        <PasswordBox x:Name="PasswordInput"
                     Grid.Row="2"
                     MinHeight="34"
                     Padding="8,5"
                     KeyboardNavigation.TabIndex="0"
                     AutomationProperties.Name="Archive password"
                     AutomationProperties.HelpText="Enter the password required to open, preview, test, or extract this archive."
                     AutomationProperties.IsRequiredForForm="True"
                     VerticalContentAlignment="Center" />

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button KeyboardNavigation.TabIndex="1"
                    Content="C_ancel"
                    IsCancel="True"
                    AutomationProperties.Name="Cancel password prompt"
                    AutomationProperties.HelpText="Close the prompt without transferring a password." />
            <Button KeyboardNavigation.TabIndex="2"
                    Content="_Continue"
                    Margin="0"
                    IsDefault="True"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="Continue_Click"
                    AutomationProperties.Name="Continue with archive password"
                    AutomationProperties.HelpText="Transfer this one-shot password to the current archive request." />
        </StackPanel>
    </Grid>
</Window>
