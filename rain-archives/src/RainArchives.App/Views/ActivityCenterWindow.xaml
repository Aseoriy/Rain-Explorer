<Window x:Class="RainArchives.App.Views.ActivityCenterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Activity Center"
        Width="1200"
        Height="760"
        MinWidth="820"
        MinHeight="540"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource BackgroundForegroundBrush}"
        WindowStartupLocation="CenterOwner"
        AutomationProperties.Name="Rain Archives Activity Center"
        AutomationProperties.HelpText="Review connection-lifetime archive operations and fixed-field support diagnostics.">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource SecondaryWindowTitleStyle}"
                           Text="Activity Center" />
                <TextBlock Margin="0,5,0,0"
                           Style="{StaticResource SecondaryWindowSecondaryTextStyle}"
                           Text="Active, queued, and retained terminal operations from this authenticated Worker connection." />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Button x:Name="RefreshButton"
                        KeyboardNavigation.TabIndex="0"
                        Content="_Refresh"
                        Command="{Binding RefreshCommand}"
                        IsDefault="True"
                        AutomationProperties.Name="Refresh activity"
                        AutomationProperties.HelpText="Request one non-overlapping activity and diagnostics refresh." />
                <Button x:Name="CloseButton"
                        KeyboardNavigation.TabIndex="1"
                        Content="_Close"
                        Click="Close_Click"
                        AutomationProperties.Name="Close Activity Center"
                        AutomationProperties.HelpText="Close this reusable nonmodal Activity Center. Operation state remains owned by the current connection." />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1"
                Margin="0,16,0,12"
                Style="{StaticResource ActivityCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource ActivitySectionHeadingStyle}"
                           Text="Connection policy" />
                <TextBlock Grid.Row="1"
                           Margin="0,6,0,0"
                           AutomationProperties.Name="Operation admission and retention policy"
                           Text="{Binding PolicySummary}"
                           TextWrapping="Wrap" />
                <TextBlock Grid.Row="2"
                           Margin="0,4,0,0"
                           Style="{StaticResource ActivitySecondaryTextStyle}"
                           Text="{Binding UnsupportedControlsText}" />
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource SecondaryWindowSectionHeadingStyle}"
                           Text="Operations" />
                <TextBlock Grid.Column="1"
                           VerticalAlignment="Center"
                           Style="{StaticResource SecondaryWindowSecondaryTextStyle}"
                           AutomationProperties.Name="Operation inventory summary"
                           Text="{Binding InventorySummaryText}" />
            </Grid>

            <Border Grid.Row="1" Style="{StaticResource ActivityCardStyle}" Padding="0">
                <Grid>
                    <DataGrid x:Name="ActivityGrid"
                              Style="{StaticResource SecondaryDataGridStyle}"
                              KeyboardNavigation.TabIndex="2"
                              AutomationProperties.Name="Archive operation activity"
                              AutomationProperties.HelpText="Connection-lifetime operations. Use the Cancel button only when the latest bounded snapshot authorizes it."
                              AutomationProperties.LiveSetting="Off"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              EnableRowVirtualization="True"
                              EnableColumnVirtualization="True"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              IsReadOnly="True"
                              ItemsSource="{Binding Operations}"
                              ScrollViewer.CanContentScroll="True"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource SecondaryDataGridRowStyle}">
                                <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
                                <Setter Property="AutomationProperties.HelpText" Value="Operation activity record. Warning and failure details are intentionally bounded and redacted." />
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Operation" Binding="{Binding OperationName}" Width="170" />
                            <DataGridTextColumn Header="Phase" Binding="{Binding PhaseText}" Width="135" />
                            <DataGridTextColumn Header="Progress" Binding="{Binding ProgressText}" Width="90" />
                            <DataGridTextColumn Header="Current item" Binding="{Binding CurrentItem}" Width="190" />
                            <DataGridTextColumn Header="Bytes" Binding="{Binding BytesText}" Width="145" />
                            <DataGridTextColumn Header="Entries" Binding="{Binding EntriesText}" Width="115" />
                            <DataGridTextColumn Header="Elapsed" Binding="{Binding ElapsedText}" Width="90" />
                            <DataGridTextColumn Header="Throughput" Binding="{Binding ThroughputText}" Width="105" />
                            <DataGridTextColumn Header="Ratio" Binding="{Binding RatioText}" Width="85" />
                            <DataGridTextColumn Header="Warnings" Binding="{Binding WarningText}" Width="105" />
                            <DataGridTextColumn Header="Outcome" Binding="{Binding OutcomeText}" Width="220" />
                            <DataGridTextColumn Header="Updated" Binding="{Binding UpdatedAtText}" Width="145" />
                            <DataGridTemplateColumn Header="Control" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Margin="4"
                                                Padding="8,3"
                                                Content="Cancel"
                                                Command="{Binding CancelCommand}"
                                                IsEnabled="{Binding CanCancel}"
                                                Visibility="{Binding CanCancel, Converter={StaticResource BooleanToVisibility}}"
                                                AutomationProperties.Name="Cancel operation"
                                                AutomationProperties.HelpText="Request cancellation for this exact operation. The terminal phase remains authoritative." />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border x:Name="ActivityLoadingState"
                            Background="{DynamicResource SurfaceBrush}"
                            TextElement.Foreground="{DynamicResource SurfaceForegroundBrush}"
                            Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibility}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">
                            <ProgressBar Width="160" Height="6" IsIndeterminate="True" />
                            <TextBlock Margin="0,12,0,0"
                                       HorizontalAlignment="Center"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       AutomationProperties.Name="Activity loading state"
                                       Text="Loading connection activity" />
                            <TextBlock Margin="0,5,0,0"
                                       TextAlignment="Center"
                                       Style="{StaticResource ActivitySecondaryTextStyle}"
                                       Text="One bounded refresh is in progress." />
                        </StackPanel>
                    </Border>

                    <Border x:Name="ActivityOfflineState"
                            Background="{DynamicResource SurfaceBrush}"
                            TextElement.Foreground="{DynamicResource SurfaceForegroundBrush}"
                            Visibility="{Binding IsOffline, Converter={StaticResource BooleanToVisibility}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">
                            <TextBlock HorizontalAlignment="Center"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       AutomationProperties.Name="Activity offline state"
                                       Text="Activity is offline" />
                            <TextBlock Margin="0,6,0,0"
                                       TextAlignment="Center"
                                       Style="{StaticResource ActivitySecondaryTextStyle}"
                                       Text="{Binding StatusText}" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="ActivityUnavailableState"
                            Background="{DynamicResource SurfaceBrush}"
                            TextElement.Foreground="{DynamicResource SurfaceForegroundBrush}"
                            Visibility="{Binding IsUnavailable, Converter={StaticResource BooleanToVisibility}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">
                            <TextBlock HorizontalAlignment="Center"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       AutomationProperties.Name="Activity unavailable state"
                                       Text="Activity is unavailable for this connection" />
                            <TextBlock Margin="0,6,0,0"
                                       TextAlignment="Center"
                                       Style="{StaticResource ActivitySecondaryTextStyle}"
                                       Text="{Binding StatusText}" />
                        </StackPanel>
                    </Border>

                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                MaxWidth="520"
                                Visibility="{Binding HasNoOperations, Converter={StaticResource BooleanToVisibility}}">
                        <TextBlock HorizontalAlignment="Center"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Text="No operation activity yet" />
                        <TextBlock Margin="0,6,0,0"
                                   TextAlignment="Center"
                                   Style="{StaticResource ActivitySecondaryTextStyle}"
                                   Text="New extraction, integrity, creation, and rebuild operations will appear here for this Worker connection." />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Expander Grid.Row="3"
                  KeyboardNavigation.TabIndex="3"
                  Margin="0,12,0,0"
                  Header="Support diagnostics (fixed fields only)"
                  AutomationProperties.Name="Fixed-field support diagnostics"
                  AutomationProperties.HelpText="Contains only bounded protocol capability and count fields. It never includes paths, recovery identifiers, secrets, provider messages, or mutation authority.">
            <Border Margin="0,7,0,0" Style="{StaticResource ActivityCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.ColumnSpan="2" Margin="0,0,0,7" Text="{Binding SupportDiagnostics.AvailabilityText}" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="1" FontWeight="SemiBold" Text="Protocol" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SupportDiagnostics.ProtocolText}" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="2" FontWeight="SemiBold" Text="Containment" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SupportDiagnostics.ContainmentText}" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="3" FontWeight="SemiBold" Text="Security boundary" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SupportDiagnostics.SandboxText}" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="4" FontWeight="SemiBold" Text="Admission" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SupportDiagnostics.AdmissionText}" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="5" FontWeight="SemiBold" Text="Current counts" />
                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SupportDiagnostics.CurrentCountsText}" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="6" FontWeight="SemiBold" Text="Controls" />
                    <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding SupportDiagnostics.ControlsText}" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="7" FontWeight="SemiBold" Text="Recovery" />
                    <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding SupportDiagnostics.RecoveryText}" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="8" FontWeight="SemiBold" Text="Persistence" />
                    <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding SupportDiagnostics.PersistenceText}" TextWrapping="Wrap" />
                </Grid>
            </Border>
        </Expander>

        <Grid Grid.Row="4" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ActivityStatus"
                       VerticalAlignment="Center"
                       AutomationProperties.Name="Activity Center status"
                       AutomationProperties.LiveSetting="Polite"
                       Text="{Binding StatusText}"
                       TextWrapping="Wrap" />
            <StackPanel Grid.Column="1" Margin="14,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                <ProgressBar Width="70"
                             Height="5"
                             IsIndeterminate="True"
                             Visibility="{Binding IsRefreshing, Converter={StaticResource BooleanToVisibility}}" />
                <TextBlock Margin="8,0,0,0"
                           VerticalAlignment="Center"
                           Style="{StaticResource ActivitySecondaryTextStyle}"
                           Text="{Binding LastRefreshedText}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
