<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:RainExplorer.Controls"
             x:Class="RainExplorer.Controls.CommandBoxView">
    <!-- Command box: runs one command at a time in the pane's current folder (Ctrl+`) -->
    <Border Padding="14,8,14,10" Background="{DynamicResource Glass1}"
            BorderBrush="{DynamicResource Line1}" BorderThickness="0,1,0,0">
        <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="2">
                    <Button x:Name="ClearButton" Theme="{StaticResource IconButton}" Width="26" Height="24"
                            Click="Clear_Click" ToolTip.Tip="Clear the output" AutomationProperties.Name="Clear the output">
                        <c:Icon Kind="trash" Width="13" Height="13" />
                    </Button>
                    <Button x:Name="TerminalButton" Theme="{StaticResource IconButton}" Width="26" Height="24"
                            Click="Terminal_Click" ToolTip.Tip="Open a terminal here" AutomationProperties.Name="Open a terminal here">
                        <c:Icon Kind="terminal" Width="13" Height="13" />
                    </Button>
                    <Button x:Name="CloseButton" Theme="{StaticResource IconButton}" Width="26" Height="24"
                            Click="Close_Click" AutomationProperties.Name="Close the command box">
                        <c:Icon Kind="x" Width="13" Height="13" />
                    </Button>
                </StackPanel>
                <TextBlock Text="COMMAND BOX" FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFaint}" />
                <TextBlock x:Name="FolderText" Margin="10,0,0,0" FontSize="11.5" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextMuted}" TextTrimming="PathSegmentEllipsis"
                           FontFamily="{DynamicResource MonoFont}" />
            </DockPanel>
            <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <Button x:Name="RunButton" DockPanel.Dock="Right" Content="Run" Theme="{StaticResource PrimaryButton}"
                        Classes="small" Margin="8,0,0,0" Click="Run_Click" />
                <TextBlock DockPanel.Dock="Left" Text="$" FontFamily="{DynamicResource MonoFont}" VerticalAlignment="Center"
                           Foreground="{DynamicResource AccentBright}" Margin="2,0,8,0" />
                <TextBox x:Name="Input" Classes="field" Height="32" FontFamily="{DynamicResource MonoFont}"
                         Watermark="ls -la   ·   cd ..   ·   ↑ ↓ for history   ·   Esc closes"
                         KeyDown="Input_KeyDown" AutomationProperties.Name="Command to run in this folder" />
            </DockPanel>
            <ScrollViewer x:Name="OutputScroll" Height="140" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto" Background="{DynamicResource Glass2}" Padding="10,8">
                <SelectableTextBlock x:Name="Output" FontFamily="{DynamicResource MonoFont}" FontSize="11.5"
                                     Foreground="{DynamicResource TextDim}" />
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
