<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:RainExplorer.Controls"
             x:Class="RainExplorer.Controls.PreviewPane"
             MinWidth="240">
    <Border Background="{DynamicResource Glass2}" BorderBrush="{DynamicResource Line1}" BorderThickness="1,0,0,0">
        <DockPanel>
            <!-- Header: file name + close -->
            <Border DockPanel.Dock="Top" Padding="14,10" BorderBrush="{DynamicResource Line1}" BorderThickness="0,0,0,1">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Theme="{StaticResource IconButton}" Click="Close_Click"
                            ToolTip.Tip="Hide preview (Space)" AutomationProperties.Name="Hide preview pane">
                        <c:Icon Kind="x" Width="15" Height="15" />
                    </Button>
                    <TextBlock x:Name="NameText" VerticalAlignment="Center" Foreground="{DynamicResource Text}"
                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </Border>

            <!-- Footer: metadata line -->
            <Border DockPanel.Dock="Bottom" Padding="14,8" BorderBrush="{DynamicResource Line1}" BorderThickness="0,1,0,0">
                <TextBlock x:Name="MetaText" Foreground="{DynamicResource TextMuted}" FontSize="11"
                           TextTrimming="CharacterEllipsis" />
            </Border>

            <!-- PDF page navigation -->
            <Border x:Name="PdfBar" DockPanel.Dock="Bottom" IsVisible="False" Padding="10,6"
                    BorderBrush="{DynamicResource Line1}" BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6">
                    <Button x:Name="PdfPrev" Theme="{StaticResource IconButton}" Click="PdfPrev_Click"
                            ToolTip.Tip="Previous page" AutomationProperties.Name="Previous page">
                        <c:Icon Kind="arrow-left" Width="15" Height="15" />
                    </Button>
                    <TextBlock x:Name="PdfPage" VerticalAlignment="Center" MinWidth="64" TextAlignment="Center"
                               Foreground="{DynamicResource TextDim}" FontSize="12" />
                    <Button x:Name="PdfNext" Theme="{StaticResource IconButton}" Click="PdfNext_Click"
                            ToolTip.Tip="Next page" AutomationProperties.Name="Next page">
                        <c:Icon Kind="arrow-right" Width="15" Height="15" />
                    </Button>
                </StackPanel>
            </Border>

            <!-- Audio / video: play in the desktop media player -->
            <Border x:Name="MediaBar" DockPanel.Dock="Bottom" IsVisible="False" Padding="10,6"
                    BorderBrush="{DynamicResource Line1}" BorderThickness="0,1,0,0">
                <DockPanel>
                    <Button DockPanel.Dock="Left" Theme="{StaticResource IconButton}" Click="Play_Click"
                            ToolTip.Tip="Play in media player" AutomationProperties.Name="Play in media player">
                        <c:Icon Kind="play" Width="15" Height="15" />
                    </Button>
                    <TextBlock x:Name="MediaText" VerticalAlignment="Center" Margin="8,0,0,0"
                               Foreground="{DynamicResource TextDim}" FontSize="12" TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </Border>

            <!-- Content: image / text / empty (visibility-switched) -->
            <Panel Margin="10">
                <Image x:Name="ImageView" Stretch="Uniform" IsVisible="False"
                       RenderOptions.BitmapInterpolationMode="HighQuality" />

                <StackPanel x:Name="AudioView" IsVisible="False" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <c:Icon Kind="music" Width="72" Height="72" StrokeThickness="1.2"
                            HorizontalAlignment="Center" Foreground="{DynamicResource TextFaint}" />
                </StackPanel>

                <ScrollViewer x:Name="TextScroll" IsVisible="False"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <SelectableTextBlock x:Name="TextView" Foreground="{DynamicResource TextDim}"
                                         FontFamily="{DynamicResource MonoFont}" FontSize="12" TextWrapping="NoWrap" />
                </ScrollViewer>

                <StackPanel x:Name="EmptyView" IsVisible="False" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <c:Icon x:Name="EmptyIcon" Width="60" Height="60" Kind="file" StrokeThickness="1.3"
                            HorizontalAlignment="Center" Foreground="{DynamicResource TextFaint}" />
                    <TextBlock x:Name="EmptyText" Foreground="{DynamicResource TextFaint}" Margin="0,14,0,0"
                               HorizontalAlignment="Center" FontSize="13" TextAlignment="Center" MaxWidth="220"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Panel>
        </DockPanel>
    </Border>
</UserControl>
