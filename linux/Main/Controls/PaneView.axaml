<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RainExplorer.ViewModels"
             xmlns:m="using:RainExplorer.Models"
             xmlns:c="using:RainExplorer.Controls"
             xmlns:h="using:RainExplorer.Helpers"
             x:Class="RainExplorer.Controls.PaneView"
             x:DataType="vm:PaneViewModel"
             Background="Transparent">
    <UserControl.Resources>
        <!-- ===== Layouts (swapped by the Layout menu) ===== -->
        <ItemsPanelTemplate x:Key="RowsPanel">
            <VirtualizingStackPanel />
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="IconWrapPanel">
            <WrapPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>

        <!-- Details row: GridView-style cells sharing the header's column widths -->
        <DataTemplate x:Key="DetailsTemplate" x:DataType="m:FileItem">
            <Grid Background="Transparent" Opacity="{Binding RowOpacity}" Classes.cut="{Binding IsCut}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding Name, Source={x:Static c:FileColumns.Shared}}" />
                    <ColumnDefinition Width="{Binding Modified, Source={x:Static c:FileColumns.Shared}}" />
                    <ColumnDefinition Width="{Binding Created, Source={x:Static c:FileColumns.Shared}}" />
                    <ColumnDefinition Width="{Binding Type, Source={x:Static c:FileColumns.Shared}}" />
                    <ColumnDefinition Width="{Binding Size, Source={x:Static c:FileColumns.Shared}}" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Margin="6,0" ClipToBounds="True">
                    <Panel Width="17" Height="17" Margin="0,0,10,0" VerticalAlignment="Center">
                        <c:Icon Kind="{Binding IconKey}" Foreground="{Binding IconBrush}" StrokeThickness="1.7"
                                IsVisible="{Binding !HasIcon}" />
                        <Image Source="{Binding Icon}" IsVisible="{Binding HasIcon}"
                               RenderOptions.BitmapInterpolationMode="HighQuality" />
                        <c:Icon Kind="link" Width="9" Height="9" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                Margin="0,0,-3,-3" StrokeThickness="2" Foreground="{DynamicResource Text}"
                                IsVisible="{Binding IsSymlink}" />
                    </Panel>
                    <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"
                               Foreground="{DynamicResource Text}" TextTrimming="CharacterEllipsis"
                               IsVisible="{Binding IsNotEditing}" />
                    <TextBox Classes="inline" Text="{Binding EditName, Mode=TwoWay}" MinWidth="160" Height="24"
                             VerticalAlignment="Center" IsVisible="{Binding IsEditing}"
                             KeyDown="InlineBox_KeyDown" LostFocus="InlineBox_LostFocus" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding ModifiedText}" Classes="meta mono" />
                <TextBlock Grid.Column="2" Text="{Binding CreatedText}" Classes="meta mono" />
                <TextBlock Grid.Column="3" Text="{Binding TypeLabel}" Classes="meta" />
                <TextBlock Grid.Column="4" Text="{Binding SizeText}" Classes="meta mono"
                           HorizontalAlignment="Right" TextAlignment="Right" />
            </Grid>
        </DataTemplate>

        <!-- Recursive search results: name + containing folder -->
        <DataTemplate x:Key="SearchTemplate" x:DataType="m:FileItem">
            <Grid Background="Transparent" Opacity="{Binding RowOpacity}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding Name, Source={x:Static c:FileColumns.Shared}}" />
                    <ColumnDefinition Width="{Binding Modified, Source={x:Static c:FileColumns.Shared}}" />
                    <ColumnDefinition Width="{Binding Created, Source={x:Static c:FileColumns.Shared}}" />
                    <ColumnDefinition Width="{Binding Type, Source={x:Static c:FileColumns.Shared}}" />
                    <ColumnDefinition Width="{Binding Size, Source={x:Static c:FileColumns.Shared}}" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Margin="6,0" ClipToBounds="True">
                    <Panel Width="17" Height="17" Margin="0,0,10,0" VerticalAlignment="Center">
                        <c:Icon Kind="{Binding IconKey}" Foreground="{Binding IconBrush}" StrokeThickness="1.7"
                                IsVisible="{Binding !HasIcon}" />
                        <Image Source="{Binding Icon}" IsVisible="{Binding HasIcon}"
                               RenderOptions.BitmapInterpolationMode="HighQuality" />
                    </Panel>
                    <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"
                               Foreground="{DynamicResource Text}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding ModifiedText}" Classes="meta mono" />
                <TextBlock Grid.Column="2" Grid.ColumnSpan="2" Classes="meta" ToolTip.Tip="{Binding FullPath}"
                           Text="{Binding FullPath, Converter={x:Static c:ParentFolderConverter.Instance}}"
                           TextTrimming="LeadingCharacterEllipsis" />
                <TextBlock Grid.Column="4" Text="{Binding SizeText}" Classes="meta mono"
                           HorizontalAlignment="Right" TextAlignment="Right" />
            </Grid>
        </DataTemplate>

        <!-- List: compact icon + name -->
        <DataTemplate x:Key="ListItemTemplate" x:DataType="m:FileItem">
            <StackPanel Orientation="Horizontal" Width="232" Margin="8,5" Background="Transparent"
                        Opacity="{Binding RowOpacity}" Classes.cut="{Binding IsCut}">
                <Panel Width="16" Height="16" Margin="0,0,9,0" VerticalAlignment="Center">
                    <c:Icon Kind="{Binding IconKey}" Foreground="{Binding IconBrush}" StrokeThickness="1.7"
                            IsVisible="{Binding !HasIcon}" />
                    <Image Source="{Binding Icon}" IsVisible="{Binding HasIcon}"
                           RenderOptions.BitmapInterpolationMode="HighQuality" />
                </Panel>
                <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" Foreground="{DynamicResource Text}"
                           TextTrimming="CharacterEllipsis" MaxWidth="200" IsVisible="{Binding IsNotEditing}" />
                <TextBox Classes="inline" Text="{Binding EditName, Mode=TwoWay}" Width="200" Height="24"
                         IsVisible="{Binding IsEditing}" KeyDown="InlineBox_KeyDown" LostFocus="InlineBox_LostFocus" />
            </StackPanel>
        </DataTemplate>

        <!-- Tiles: medium icon + name + type, card-like -->
        <DataTemplate x:Key="TileTemplateMedium" x:DataType="m:FileItem">
            <StackPanel Orientation="Horizontal" Width="216" Margin="10,8" Background="Transparent"
                        Opacity="{Binding RowOpacity}" Classes.cut="{Binding IsCut}">
                <Panel Width="30" Height="30" Margin="0,0,12,0" VerticalAlignment="Center">
                    <c:Icon Kind="{Binding IconKey}" Foreground="{Binding IconBrush}" StrokeThickness="1.6"
                            IsVisible="{Binding !HasLargeIcon}" />
                    <Image Source="{Binding LargeIcon}" IsVisible="{Binding HasLargeIcon}"
                           RenderOptions.BitmapInterpolationMode="HighQuality" />
                </Panel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource Text}" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" MaxWidth="150" IsVisible="{Binding IsNotEditing}" />
                    <TextBox Classes="inline" Text="{Binding EditName, Mode=TwoWay}" Width="150" Height="24"
                             IsVisible="{Binding IsEditing}" KeyDown="InlineBox_KeyDown" LostFocus="InlineBox_LostFocus" />
                    <TextBlock Text="{Binding TypeLabel}" Foreground="{DynamicResource TextMuted}" FontSize="11"
                               Margin="0,2,0,0" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <!-- Grid: photo thumbnail (when available) or large icon over centered name -->
        <DataTemplate x:Key="TileTemplateLarge" x:DataType="m:FileItem">
            <StackPanel Width="132" Margin="6,10" HorizontalAlignment="Center" Background="Transparent"
                        Opacity="{Binding RowOpacity}" Classes.cut="{Binding IsCut}">
                <Border Width="116" Height="82" CornerRadius="7" ClipToBounds="True"
                        Background="{DynamicResource Glass2}" HorizontalAlignment="Center">
                    <Panel>
                        <Panel IsVisible="{Binding !HasGridThumbnail}">
                            <c:Icon Kind="{Binding IconKey}" Foreground="{Binding IconBrush}" Width="46" Height="46"
                                    StrokeThickness="1.4" IsVisible="{Binding !HasLargeIcon}" />
                            <Image Source="{Binding LargeIcon}" Width="46" Height="46"
                                   IsVisible="{Binding HasLargeIcon}" RenderOptions.BitmapInterpolationMode="HighQuality" />
                        </Panel>
                        <Image Source="{Binding GridThumbnail}" Stretch="UniformToFill"
                               IsVisible="{Binding HasGridThumbnail}" RenderOptions.BitmapInterpolationMode="HighQuality" />
                    </Panel>
                </Border>
                <TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource Text}" HorizontalAlignment="Center"
                           TextAlignment="Center" Margin="0,8,0,0" TextTrimming="CharacterEllipsis"
                           TextWrapping="Wrap" MaxHeight="34" MaxWidth="124" FontSize="12"
                           IsVisible="{Binding IsNotEditing}" />
                <TextBox Classes="inline" Text="{Binding EditName, Mode=TwoWay}" Margin="0,6,0,0" Width="124" Height="24"
                         IsVisible="{Binding IsEditing}" KeyDown="InlineBox_KeyDown" LostFocus="InlineBox_LostFocus" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- Muted cell text for date / type / size -->
        <Style Selector="TextBlock.meta">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Margin" Value="6,0" />
        </Style>
        <Style Selector="TextBlock.mono">
            <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
        </Style>
        <Style Selector="Grid.cut, StackPanel.cut">
            <Setter Property="Opacity" Value="0.45" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <!-- ===== Tab strip ===== -->
        <Grid Grid.Row="0" Background="Transparent" x:Name="TabStrip">
            <Grid Margin="8,6,0,4" RowDefinitions="Auto,Auto">
                <Grid Grid.Row="0" VerticalAlignment="Bottom" ColumnDefinitions="Auto,*">
                    <Button x:Name="ProjectsButton" Grid.Column="0" Theme="{StaticResource IconButton}" Width="NaN"
                            MinWidth="88" Padding="9,0" VerticalAlignment="Bottom" Margin="0,0,6,2"
                            Click="ProjectsButton_Click" ToolTip.Tip="Switch tab project">
                        <StackPanel Orientation="Horizontal">
                            <c:Icon Kind="package" Width="15" Height="15" Margin="0,0,6,0" />
                            <TextBlock x:Name="ProjectsButtonText" Text="Tab projects" MaxWidth="170"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Panel x:Name="TopTabDropSurface" Grid.Column="1" DragDrop.AllowDrop="True">
                        <ListBox x:Name="TabBar" ItemsSource="{Binding TopLevelTabs}"
                                 SelectedItem="{Binding SelectedTopTab, Mode=TwoWay}"
                                 ItemContainerTheme="{StaticResource TabItem}"
                                 HorizontalAlignment="Stretch" Background="Transparent" BorderThickness="0" Padding="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                 DragDrop.AllowDrop="True">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <c:AdaptiveTabPanel MinimumItemWidth="52" MaximumItemWidth="208"
                                                        PinnedItemWidth="40" ReservedWidth="36" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>
                        <Button x:Name="NewTabButton" Theme="{StaticResource IconButton}" Width="32" Height="32"
                                HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="0,0,0,2" ZIndex="30"
                                Command="{Binding NewTabCommand}" ToolTip.Tip="New tab (Ctrl+T)"
                                AutomationProperties.Name="New tab">
                            <Button.RenderTransform><TranslateTransform /></Button.RenderTransform>
                            <c:Icon Kind="plus" Width="16" Height="16" />
                        </Button>
                    </Panel>
                </Grid>

                <Border Grid.Row="1" Margin="0,3,36,0" Padding="3,2"
                        Background="{DynamicResource Glass2}" BorderBrush="{DynamicResource Line1}"
                        BorderThickness="1" CornerRadius="8" h:ExpandCollapseBehavior.IsExpanded="{Binding HasActiveGroup}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Theme="{StaticResource IconButton}" Width="26" Height="24"
                                Margin="4,0,0,0" Click="NewActiveGroupTab_Click" ToolTip.Tip="New tab in this group">
                            <c:Icon Kind="plus" Width="13" Height="13" />
                        </Button>
                        <ListBox x:Name="GroupTabBar" ItemsSource="{Binding ActiveGroupTabs}"
                                 SelectedItem="{Binding SelectedTab, Mode=TwoWay}"
                                 ItemContainerTheme="{StaticResource GroupChildTab}"
                                 Background="Transparent" BorderThickness="0" Padding="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <c:AdaptiveTabPanel MinimumItemWidth="64" MaximumItemWidth="190" PinnedItemWidth="64" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Grid>
            <Canvas x:Name="TabAnimationLayer" IsHitTestVisible="False" ZIndex="40" />
        </Grid>

        <!-- ===== Navigation bar (scoped to the active tab) ===== -->
        <Border Grid.Row="1" Background="Transparent" BorderBrush="{DynamicResource Line1}" BorderThickness="0,0,0,1"
                Padding="12,8" DataContext="{Binding DisplayedTab}" x:DataType="vm:TabViewModel">
            <Grid x:Name="NavigationGrid" ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
                <!-- nav buttons -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,8,0">
                    <Button Theme="{StaticResource IconButton}" Command="{Binding BackCommand}" ToolTip.Tip="Back (Alt+Left)"
                            AutomationProperties.Name="Back">
                        <c:Icon Kind="arrow-left" Width="17" Height="17" />
                    </Button>
                    <Button Theme="{StaticResource IconButton}" Command="{Binding ForwardCommand}" ToolTip.Tip="Forward (Alt+Right)"
                            AutomationProperties.Name="Forward">
                        <c:Icon Kind="arrow-right" Width="17" Height="17" />
                    </Button>
                    <Button Theme="{StaticResource IconButton}" Command="{Binding UpCommand}" ToolTip.Tip="Up (Alt+Up)"
                            AutomationProperties.Name="Up one folder">
                        <c:Icon Kind="arrow-up" Width="17" Height="17" />
                    </Button>
                    <Button Theme="{StaticResource IconButton}" Command="{Binding RefreshCommand}" ToolTip.Tip="Refresh (F5)"
                            AutomationProperties.Name="Refresh folder">
                        <c:Icon Kind="refresh" Width="16" Height="16" />
                    </Button>
                </StackPanel>

                <!-- Address bar: clickable breadcrumb that flips to an editable path box (Ctrl+L) -->
                <c:BreadcrumbBar x:Name="AddressBar" Grid.Column="1" VerticalAlignment="Center" />

                <Grid x:Name="SearchActions" Grid.Column="2" ColumnDefinitions="Auto,Auto">
                    <!-- Search pill: search glyph + filter + recursive toggle -->
                    <Border x:Name="SearchPill" Grid.Column="0" Width="210" Margin="8,0,0,0" Background="{DynamicResource Glass2}"
                            BorderBrush="{DynamicResource Line2}" BorderThickness="1" CornerRadius="8"
                            Height="30" VerticalAlignment="Center">
                        <DockPanel Margin="10,0,2,0">
                            <c:Icon DockPanel.Dock="Left" Kind="search" Width="14" Height="14" Margin="0,0,8,0"
                                    VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}" />
                            <ToggleButton DockPanel.Dock="Right" Theme="{StaticResource ToggleChip}"
                                          IsChecked="{Binding Recursive, Mode=TwoWay}"
                                          ToolTip.Tip="Search subfolders (recursive)"
                                          AutomationProperties.Name="Search subfolders recursively">
                                <c:Icon Kind="recursive" Width="15" Height="15" />
                            </ToggleButton>
                            <TextBox x:Name="SearchBox" Classes="bare" Watermark="Search"
                                     Text="{Binding Filter, Mode=TwoWay}" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>

                    <!-- Sort / View / Preview / Split -->
                    <StackPanel x:Name="ToolbarActions" Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                        <Button x:Name="SortButton" Theme="{StaticResource IconButton}" Click="SortButton_Click"
                                ToolTip.Tip="Sort by" AutomationProperties.Name="Sort files">
                            <c:Icon Kind="sliders" Width="16" Height="16" />
                        </Button>
                        <Button x:Name="LayoutButton" Theme="{StaticResource IconButton}" Margin="2,0,0,0"
                                Click="LayoutButton_Click" ToolTip.Tip="Layout" AutomationProperties.Name="Choose folder layout">
                            <c:Icon Kind="list" Width="16" Height="16" />
                        </Button>
                        <ToggleButton x:Name="PreviewToggle" Theme="{StaticResource ToggleChip}" Margin="2,0,0,0"
                                      ToolTip.Tip="Preview pane (Space)" AutomationProperties.Name="Show preview pane"
                                      Click="PreviewToggle_Click">
                            <c:Icon Kind="eye" Width="16" Height="16" />
                        </ToggleButton>
                        <Button Theme="{StaticResource IconButton}" Margin="2,0,0,0" Click="SplitButton_Click"
                                ToolTip.Tip="Toggle split view" AutomationProperties.Name="Toggle split view">
                            <c:Icon Kind="split" Width="16" Height="16" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Grid x:Name="TabContentHost" Grid.Row="2" DataContext="{Binding DisplayedTab}" x:DataType="vm:TabViewModel">
            <c:HomeView ZIndex="2" Background="{DynamicResource AppBackgroundBrush}" IsVisible="{Binding IsHomeView}" />
            <c:DrivesView ZIndex="2" Background="{DynamicResource AppBackgroundBrush}" IsVisible="{Binding IsDrivesView}" />
            <!-- Folder view: file list, with an optional preview pane on the right. -->
            <Grid x:Name="FolderGrid" IsVisible="{Binding IsFolderView}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="240" />
                    <ColumnDefinition Width="0" />
                    <ColumnDefinition Width="0" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" RowDefinitions="Auto,*">
                    <!-- GridView-style column headers (Details layout only) -->
                    <Grid x:Name="HeaderRow" Grid.Row="0" HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{Binding Name, Source={x:Static c:FileColumns.Shared}}" />
                            <ColumnDefinition Width="{Binding Modified, Source={x:Static c:FileColumns.Shared}}" />
                            <ColumnDefinition Width="{Binding Created, Source={x:Static c:FileColumns.Shared}}" />
                            <ColumnDefinition Width="{Binding Type, Source={x:Static c:FileColumns.Shared}}" />
                            <ColumnDefinition Width="{Binding Size, Source={x:Static c:FileColumns.Shared}}" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="ColName" Grid.Column="0" Theme="{StaticResource ColumnHeader}" Content="Name" Tag="Name" Click="Header_Click" />
                        <Thumb Grid.Column="0" Theme="{StaticResource ColumnGrip}" Tag="Name" DragDelta="ColumnGrip_DragDelta" />
                        <Button x:Name="ColDate" Grid.Column="1" Theme="{StaticResource ColumnHeader}" Content="Date modified" Tag="Modified" Click="Header_Click" />
                        <Thumb Grid.Column="1" Theme="{StaticResource ColumnGrip}" Tag="Modified" DragDelta="ColumnGrip_DragDelta" />
                        <Button x:Name="ColCreated" Grid.Column="2" Theme="{StaticResource ColumnHeader}" Content="Date created" Tag="Created" Click="Header_Click" />
                        <Thumb Grid.Column="2" Theme="{StaticResource ColumnGrip}" Tag="Created" DragDelta="ColumnGrip_DragDelta" />
                        <Button x:Name="ColType" Grid.Column="3" Theme="{StaticResource ColumnHeader}" Content="Type" Tag="Type" Click="Header_Click" />
                        <Thumb Grid.Column="3" Theme="{StaticResource ColumnGrip}" Tag="Type" DragDelta="ColumnGrip_DragDelta" />
                        <Button x:Name="ColSize" Grid.Column="4" Theme="{StaticResource ColumnHeader}" Content="Size" Tag="Size" Click="Header_Click" />
                        <Thumb Grid.Column="4" Theme="{StaticResource ColumnGrip}" Tag="Size" DragDelta="ColumnGrip_DragDelta" />
                    </Grid>

                    <ListBox x:Name="FileList" Grid.Row="1"
                             ItemContainerTheme="{StaticResource FileRow}"
                             ItemTemplate="{StaticResource DetailsTemplate}"
                             ItemsPanel="{StaticResource RowsPanel}"
                             SelectionMode="Multiple"
                             Background="Transparent" BorderThickness="0" Padding="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             DragDrop.AllowDrop="True"
                             SelectionChanged="FileList_SelectionChanged"
                             DoubleTapped="FileList_DoubleTapped">
                        <ListBox.RenderTransform>
                            <TranslateTransform />
                        </ListBox.RenderTransform>
                    </ListBox>

                    <!-- Rubber-band selection rectangle (drawn over the list; never hit-tested) -->
                    <Canvas x:Name="MarqueeLayer" Grid.Row="1" IsHitTestVisible="False">
                        <Border x:Name="Marquee" IsVisible="False" CornerRadius="2"
                                Background="{DynamicResource AccentWash2}"
                                BorderBrush="{DynamicResource AccentLine}" BorderThickness="1" />
                    </Canvas>
                </Grid>

                <GridSplitter x:Name="PreviewSplitter" Grid.Column="1" Width="6" ResizeDirection="Columns"
                              Background="{DynamicResource Line1}" IsVisible="False"
                              DragCompleted="PreviewSplitter_DragCompleted" />
                <c:PreviewPane x:Name="Preview" Grid.Column="2" IsVisible="False" />
            </Grid>
        </Grid>

        <!-- ===== Status bar (toggleable via settings) ===== -->
        <Border x:Name="StatusBar" Grid.Row="3" Height="28" Background="{DynamicResource Glass2}"
                BorderBrush="{DynamicResource Line1}" BorderThickness="0,1,0,0"
                DataContext="{Binding DisplayedTab}" x:DataType="vm:TabViewModel">
            <TextBlock Text="{Binding Status}" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"
                       Margin="14,0" FontSize="12" TextTrimming="CharacterEllipsis" />
        </Border>
    </Grid>
</UserControl>
