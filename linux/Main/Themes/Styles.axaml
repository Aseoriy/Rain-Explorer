<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:RainExplorer.Controls"
        xmlns:h="using:RainExplorer.Helpers"
        xmlns:vm="using:RainExplorer.ViewModels">
    <!-- ============================================================
         Rain Explorer — Purple-glass dark theme (control templates).
         A one-to-one port of the Windows build's Themes/Dark.xaml:
         every WPF Style + ControlTemplate becomes an Avalonia
         ControlTheme with the same parts, sizes, corner radii and
         trigger states. Themes with an x:Type key replace Fluent's
         default look for that control everywhere; keyed themes are
         applied with Theme="{StaticResource …}" exactly where the
         Windows XAML used Style="{StaticResource …}".
         ============================================================ -->
    <Styles.Resources>
        <ResourceDictionary>

            <!-- ===== Toolbar / icon button (square, rounded, glass-on-hover) ===== -->
            <ControlTheme x:Key="IconButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Width" Value="30" />
                <Setter Property="Height" Value="30" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <ControlTemplate>
                        <Border Name="bg" Background="{TemplateBinding Background}"
                                BorderBrush="Transparent" BorderThickness="1" CornerRadius="6">
                            <ContentPresenter Name="PART_ContentPresenter"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Padding="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                    </ControlTemplate>
                </Setter>
                <Style Selector="^:pointerover">
                    <Setter Property="Foreground" Value="{DynamicResource Text}" />
                </Style>
                <Style Selector="^:pointerover /template/ Border#bg">
                    <Setter Property="Background" Value="{DynamicResource Glass3}" />
                </Style>
                <Style Selector="^:focus-visible /template/ Border#bg">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBright}" />
                </Style>
                <Style Selector="^:disabled">
                    <Setter Property="Opacity" Value="0.3" />
                </Style>
            </ControlTheme>

            <!-- Caption (window) buttons: muted icon, glass hover -->
            <ControlTheme x:Key="CaptionButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="30" />
            </ControlTheme>

            <!-- Close: destructive red wash on hover -->
            <ControlTheme x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
                <Style Selector="^:pointerover">
                    <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
                </Style>
                <Style Selector="^:pointerover /template/ Border#bg">
                    <Setter Property="Background" Value="{DynamicResource DangerStrong}" />
                </Style>
            </ControlTheme>

            <!-- Tab close cross: tiny square that washes on hover -->
            <ControlTheme x:Key="TabCloseButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource TextFaint}" />
                <Setter Property="Width" Value="18" />
                <Setter Property="Height" Value="18" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <ControlTemplate>
                        <Border Name="cb" Background="{TemplateBinding Background}" CornerRadius="4">
                            <c:Icon Kind="x" Width="11" Height="11" StrokeThickness="2" />
                        </Border>
                    </ControlTemplate>
                </Setter>
                <Style Selector="^:pointerover">
                    <Setter Property="Foreground" Value="{DynamicResource Text}" />
                </Style>
                <Style Selector="^:pointerover /template/ Border#cb">
                    <Setter Property="Background" Value="{DynamicResource Glass4}" />
                </Style>
            </ControlTheme>

            <!-- ===== Toggle chip (recursive-search / preview switch) ===== -->
            <ControlTheme x:Key="ToggleChip" TargetType="ToggleButton">
                <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Width" Value="28" />
                <Setter Property="Height" Value="28" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <ControlTemplate>
                        <Border Name="bg" Background="Transparent" CornerRadius="6"
                                BorderBrush="Transparent" BorderThickness="1">
                            <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter>
                <Style Selector="^:pointerover">
                    <Setter Property="Foreground" Value="{DynamicResource Text}" />
                </Style>
                <Style Selector="^:pointerover /template/ Border#bg">
                    <Setter Property="Background" Value="{DynamicResource Glass3}" />
                </Style>
                <Style Selector="^:focus-visible /template/ Border#bg">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBright}" />
                </Style>
                <Style Selector="^:checked">
                    <Setter Property="Foreground" Value="{DynamicResource AccentBright}" />
                </Style>
                <Style Selector="^:checked /template/ Border#bg">
                    <Setter Property="Background" Value="{DynamicResource AccentWash}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentLine}" />
                </Style>
            </ControlTheme>

            <!-- ===== Dialog buttons ===== -->
            <!-- Secondary / dialog button: frosted glass, hairline border -->
            <ControlTheme x:Key="DialogButton" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource Glass3}" />
                <Setter Property="Foreground" Value="{DynamicResource Text}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Line2}" />
                <Setter Property="Padding" Value="16,7" />
                <Setter Property="MinWidth" Value="84" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <ControlTemplate>
                        <Border Name="bg" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                    </ControlTemplate>
                </Setter>
                <Style Selector="^:pointerover /template/ Border#bg">
                    <Setter Property="Background" Value="{DynamicResource Glass4}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Line3}" />
                </Style>
                <Style Selector="^:focus-visible /template/ Border#bg">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBright}" />
                </Style>
                <Style Selector="^:disabled">
                    <Setter Property="Opacity" Value="0.45" />
                </Style>
            </ControlTheme>

            <!-- Ghost button: transparent until hovered -->
            <ControlTheme x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource DialogButton}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
                <Style Selector="^:pointerover">
                    <Setter Property="Foreground" Value="{DynamicResource Text}" />
                </Style>
                <Style Selector="^:pointerover /template/ Border#bg">
                    <Setter Property="Background" Value="{DynamicResource Glass3}" />
                    <Setter Property="BorderBrush" Value="Transparent" />
                </Style>
            </ControlTheme>

            <!-- Primary button: accent-gradient pill with a soft glow that blooms on hover -->
            <ControlTheme x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource DialogButton}">
                <Setter Property="Background" Value="{DynamicResource GradientAccent}" />
                <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
                <Setter Property="Template">
                    <ControlTemplate>
                        <Border Name="bg" Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource PrimaryBorder}" BorderThickness="1"
                                CornerRadius="10" Padding="{TemplateBinding Padding}"
                                BoxShadow="{DynamicResource PrimaryGlow}">
                            <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                    </ControlTemplate>
                </Setter>
                <Style Selector="^:pointerover /template/ Border#bg">
                    <Setter Property="Background" Value="{DynamicResource GradientAccentHover}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBorder}" />
                    <Setter Property="BoxShadow" Value="{DynamicResource PrimaryGlowHover}" />
                </Style>
                <Style Selector="^:focus-visible /template/ Border#bg">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBright}" />
                </Style>
            </ControlTheme>

            <!-- Danger-tinted dialog button ("Delete permanently") -->
            <ControlTheme x:Key="DangerDialogButton" TargetType="Button" BasedOn="{StaticResource DialogButton}">
                <Setter Property="Foreground" Value="{DynamicResource Danger}" />
            </ControlTheme>

            <!-- Breadcrumb segment -->
            <ControlTheme x:Key="CrumbButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Padding" Value="6,2" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Template">
                    <ControlTemplate>
                        <Border Name="b" Background="{TemplateBinding Background}" CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter>
                <Style Selector="^:pointerover">
                    <Setter Property="Foreground" Value="{DynamicResource Text}" />
                </Style>
                <Style Selector="^:pointerover /template/ Border#b">
                    <Setter Property="Background" Value="{DynamicResource Glass3}" />
                </Style>
                <Style Selector="^.current">
                    <Setter Property="Foreground" Value="{DynamicResource Text}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </Style>
                <Style Selector="^.drop /template/ Border#b">
                    <Setter Property="Background" Value="{DynamicResource AccentWash}" />
                </Style>
            </ControlTheme>

            <!-- The chevron that opens a segment's subfolder list -->
            <ControlTheme x:Key="CrumbChevron" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Width" Value="16" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Template">
                    <ControlTemplate>
                        <Border Name="b" Background="{TemplateBinding Background}" CornerRadius="4" Height="22">
                            <c:Icon Kind="chevron-right" Width="8" Height="8" StrokeThickness="2"
                                    Foreground="{DynamicResource TextFaint}" />
                        </Border>
                    </ControlTemplate>
                </Setter>
                <Style Selector="^:pointerover /template/ Border#b">
                    <Setter Property="Background" Value="{DynamicResource Glass3}" />
                </Style>
            </ControlTheme>

            <!-- A chrome-less clickable surface: the content draws everything. -->
            <ControlTheme x:Key="BareButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <ControlTemplate>
                        <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Background="{TemplateBinding Background}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </ControlTemplate>
                </Setter>
            </ControlTheme>

            <!-- ===== Sidebar-style nav item (Settings / Properties): accent wash + bar ===== -->
            <ControlTheme x:Key="NavItem" TargetType="ListBoxItem">
                <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
                <Setter Property="Margin" Value="0,2" />
                <Setter Property="Padding" Value="11,9" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <ControlTemplate>
                        <Panel>
                            <Border Name="bg" Background="Transparent" CornerRadius="9"
                                    BorderBrush="Transparent" BorderThickness="1" Padding="{TemplateBinding Padding}">
                                <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <Border Name="bar" Width="3" Height="18" CornerRadius="2" HorizontalAlignment="Left"
                                    Background="{DynamicResource GradientAccent}" IsVisible="False" />
                        </Panel>
                    </ControlTemplate>
                </Setter>
                <Style Selector="^:pointerover">
                    <Setter Property="Foreground" Value="{DynamicResource Text}" />
                </Style>
                <Style Selector="^:pointerover /template/ Border#bg">
                    <Setter Property="Background" Value="{DynamicResource Glass3}" />
                </Style>
                <Style Selector="^:selected">
                    <Setter Property="Foreground" Value="{DynamicResource Text}" />
                </Style>
                <Style Selector="^:selected /template/ Border#bg">
                    <Setter Property="Background" Value="{DynamicResource AccentWash}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentLine}" />
                </Style>
                <Style Selector="^:selected /template/ Border#bar">
                    <Setter Property="IsVisible" Value="True" />
                </Style>
            </ControlTheme>

            <!-- Properties dialog left nav (Windows "PropNav": NavItem, a little tighter) -->
            <ControlTheme x:Key="PropNav" TargetType="ListBoxItem" BasedOn="{StaticResource NavItem}">
                <Setter Property="Padding" Value="10,8" />
            </ControlTheme>

            <!-- Icon picker swatch (Windows "IconSwatch") -->
            <ControlTheme x:Key="IconSwatch" TargetType="ListBoxItem">
                <Setter Property="Margin" Value="4" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
                <Setter Property="Template">
                    <ControlTemplate>
                        <Border Name="b" Width="46" Height="46" CornerRadius="9" Background="{DynamicResource Glass2}"
                                BorderBrush="{DynamicResource Line2}" BorderThickness="1">
                            <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter>
                <Style Selector="^:pointerover /template/ Border#b">
                    <Setter Property="BorderBrush" Value="{DynamicResource Line3}" />
                </Style>
                <Style Selector="^:selected /template/ Border#b">
                    <Setter Property="Background" Value="{DynamicResource AccentWash}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentLine}" />
                </Style>
            </ControlTheme>

            <!-- ===== File rows (Details) ===== -->
            <ControlTheme x:Key="FileRow" TargetType="ListBoxItem">
                <Setter Property="Foreground" Value="{DynamicResource Text}" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="6,0" />
                <Setter Property="Template">
                    <ControlTemplate>
                        <Border Name="bg" Background="Transparent" CornerRadius="6"
                                BorderBrush="Transparent" BorderThickness="1"
                                Padding="{DynamicResource RowPadding}">
                            <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter>
                <Style Selector="^:pointerover /template/ Border#bg">
                    <Setter Property="Background" Value="{DynamicResource Glass3}" />
                </Style>
                <Style Selector="^:selected /template/ Border#bg">
                    <Setter Property="Background" Value="{DynamicResource AccentWash}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentLine}" />
                </Style>
                <!-- Drag hovering this folder row: stronger accent so the drop target is obvious. -->
                <Style Selector="^.drop /template/ Border#bg">
                    <Setter Property="Background" Value="{DynamicResource AccentWash2}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBright}" />
                </Style>
            </ControlTheme>

            <!-- Selectable container for the icon layouts (List / Tiles / Grid) -->
            <ControlTheme x:Key="TileItem" TargetType="ListBoxItem">
                <Setter Property="Margin" Value="3" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Foreground" Value="{DynamicResource Text}" />
                <Setter Property="Template">
                    <ControlTemplate>
                        <Border Name="b" Background="Transparent" CornerRadius="9"
                                BorderBrush="Transparent" BorderThickness="1">
                            <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}" />
                        </Border>
                    </ControlTemplate>
                </Setter>
                <Style Selector="^:pointerover /template/ Border#b">
                    <Setter Property="Background" Value="{DynamicResource Glass3}" />
                </Style>
                <Style Selector="^:selected /template/ Border#b">
                    <Setter Property="Background" Value="{DynamicResource AccentWash}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentLine}" />
                </Style>
                <Style Selector="^.drop /template/ Border#b">
                    <Setter Property="Background" Value="{DynamicResource AccentWash2}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBright}" />
                </Style>
            </ControlTheme>

            <!-- Dropdown row (breadcrumb chevron + autocomplete lists) -->
            <ControlTheme x:Key="DropItem" TargetType="ListBoxItem">
                <Setter Property="Padding" Value="8,5" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Foreground" Value="{DynamicResource Text}" />
                <Setter Property="Template">
                    <ControlTemplate>
                        <Border Name="b" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}" />
                        </Border>
                    </ControlTemplate>
                </Setter>
                <Style Selector="^:pointerover /template/ Border#b">
                    <Setter Property="Background" Value="{DynamicResource Glass3}" />
                </Style>
                <Style Selector="^:selected /template/ Border#b">
                    <Setter Property="Background" Value="{DynamicResource AccentWash}" />
                </Style>
            </ControlTheme>

            <!-- ===== Context menu (glass, rounded) ===== -->
            <ControlTheme x:Key="{x:Type ContextMenu}" TargetType="ContextMenu">
                <Setter Property="Background" Value="{DynamicResource MenuBg}" />
                <Setter Property="Foreground" Value="{DynamicResource Text}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Line2}" />
                <Setter Property="Focusable" Value="True" />
                <Setter Property="WindowManagerAddShadowHint" Value="False" />
                <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Template">
                    <ControlTemplate>
                        <Border Name="menuSurface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="10" Padding="5" Margin="8,4,8,12"
                                BoxShadow="{DynamicResource MenuShadow}"
                                h:Motion.PopupReveal="True" h:Motion.PopupOffset="-6">
                            <ScrollViewer>
                                <ItemsPresenter Name="PART_ItemsPresenter"
                                                ItemsPanel="{TemplateBinding ItemsPanel}"
                                                KeyboardNavigation.TabNavigation="Continue"
                                                Grid.IsSharedSizeScope="True" />
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter>
            </ControlTheme>

            <ControlTheme x:Key="{x:Type MenuItem}" TargetType="MenuItem">
                <Setter Property="Foreground" Value="{DynamicResource Text}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Template">
                    <ControlTemplate>
                        <Panel>
                            <Border Name="PART_LayoutRoot" Background="{TemplateBinding Background}"
                                    CornerRadius="6" Padding="9,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="MenuItemIGT" />
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Name="PART_IconPresenter" Grid.Column="0"
                                                      Content="{TemplateBinding Icon}"
                                                      VerticalAlignment="Center" HorizontalAlignment="Left" />
                                    <c:Icon Name="PART_ToggleMark" Grid.Column="0" Kind="check" Width="14" Height="14"
                                            StrokeThickness="2" Foreground="{DynamicResource AccentBright}"
                                            HorizontalAlignment="Left" IsVisible="False" />
                                    <ContentPresenter Name="PART_HeaderPresenter" Grid.Column="1"
                                                      Content="{TemplateBinding Header}"
                                                      ContentTemplate="{TemplateBinding HeaderTemplate}"
                                                      VerticalAlignment="Center" RecognizesAccessKey="True" />
                                    <TextBlock Name="PART_InputGestureText" Grid.Column="2"
                                               Text="{TemplateBinding InputGesture, Converter={x:Static c:GestureTextConverter.Instance}}"
                                               Foreground="{DynamicResource TextFaint}" FontSize="11"
                                               Margin="18,0,2,0" VerticalAlignment="Center" />
                                    <c:Icon Name="arrow" Grid.Column="2" Kind="chevron-right" Width="13" Height="13"
                                            Margin="18,0,0,0" VerticalAlignment="Center"
                                            Foreground="{DynamicResource TextMuted}" IsVisible="False" />
                                </Grid>
                            </Border>
                            <!-- Submenu flyout (same frosted look as the context menu) -->
                            <Popup Name="PART_Popup" WindowManagerAddShadowHint="False"
                                   Placement="RightEdgeAlignedTop" HorizontalOffset="-6" VerticalOffset="-10"
                                   IsLightDismissEnabled="False"
                                   IsOpen="{TemplateBinding IsSubMenuOpen, Mode=TwoWay}">
                                <Border Background="{DynamicResource MenuBg}" BorderBrush="{DynamicResource Line2}"
                                        BorderThickness="1" CornerRadius="10" Padding="5" Margin="6,4,8,12"
                                        MinWidth="200" BoxShadow="{DynamicResource MenuShadow}">
                                    <ScrollViewer MaxHeight="560">
                                        <ItemsPresenter Name="PART_ItemsPresenter"
                                                        ItemsPanel="{TemplateBinding ItemsPanel}"
                                                        Grid.IsSharedSizeScope="True" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Panel>
                    </ControlTemplate>
                </Setter>
                <Style Selector="^:selected /template/ Border#PART_LayoutRoot">
                    <Setter Property="Background" Value="{DynamicResource Glass3}" />
                </Style>
                <Style Selector="^:pointerover /template/ Border#PART_LayoutRoot">
                    <Setter Property="Background" Value="{DynamicResource Glass3}" />
                </Style>
                <Style Selector="^:disabled">
                    <Setter Property="Opacity" Value="0.35" />
                </Style>
                <!-- Items that open a submenu: show the chevron, hide the gesture text. -->
                <Style Selector="^:not(:empty) /template/ c|Icon#arrow">
                    <Setter Property="IsVisible" Value="True" />
                </Style>
                <Style Selector="^:not(:empty) /template/ TextBlock#PART_InputGestureText">
                    <Setter Property="IsVisible" Value="False" />
                </Style>
                <Style Selector="^:checked /template/ c|Icon#PART_ToggleMark">
                    <Setter Property="IsVisible" Value="True" />
                </Style>
                <Style Selector="^:separator">
                    <Setter Property="Template">
                        <ControlTemplate>
                            <Border Height="1" Margin="8,4" Background="{DynamicResource Line1}" />
                        </ControlTemplate>
                    </Setter>
                </Style>
            </ControlTheme>

            <ControlTheme x:Key="{x:Type Separator}" TargetType="Separator">
                <Setter Property="Margin" Value="8,4" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Template">
                    <ControlTemplate>
                        <Border Height="1" Background="{DynamicResource Line1}" />
                    </ControlTemplate>
                </Setter>
            </ControlTheme>

            <!-- ===== CheckBox (rounded, accent when checked) ===== -->
            <ControlTheme x:Key="{x:Type CheckBox}" TargetType="CheckBox">
                <Setter Property="Foreground" Value="{DynamicResource Text}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <ControlTemplate>
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border Name="box" Width="18" Height="18" CornerRadius="4"
                                    BorderBrush="{DynamicResource Line3}" BorderThickness="1"
                                    Background="{DynamicResource Glass2}">
                                <c:Icon Name="check" Kind="check" Foreground="{DynamicResource OnAccent}" StrokeThickness="2"
                                        Width="12" Height="12" IsVisible="False" />
                            </Border>
                            <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                                              Margin="9,0,0,0" VerticalAlignment="Center"
                                              IsVisible="{TemplateBinding Content, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        </StackPanel>
                    </ControlTemplate>
                </Setter>
                <Style Selector="^:pointerover /template/ Border#box">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentLine}" />
                </Style>
                <Style Selector="^:checked /template/ Border#box">
                    <Setter Property="Background" Value="{DynamicResource Accent}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
                </Style>
                <Style Selector="^:checked /template/ c|Icon#check">
                    <Setter Property="IsVisible" Value="True" />
                </Style>
                <Style Selector="^:disabled">
                    <Setter Property="Opacity" Value="0.45" />
                </Style>
            </ControlTheme>

            <!-- ===== ComboBox (glass) ===== -->
            <ControlTheme x:Key="{x:Type ComboBoxItem}" TargetType="ComboBoxItem">
                <Setter Property="Foreground" Value="{DynamicResource Text}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <ControlTemplate>
                        <Border Name="bg" Background="Transparent" CornerRadius="6" Padding="10,6">
                            <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}" />
                        </Border>
                    </ControlTemplate>
                </Setter>
                <Style Selector="^:pointerover /template/ Border#bg">
                    <Setter Property="Background" Value="{DynamicResource Glass3}" />
                </Style>
                <Style Selector="^:selected /template/ Border#bg">
                    <Setter Property="Background" Value="{DynamicResource AccentWash}" />
                </Style>
            </ControlTheme>

            <ControlTheme x:Key="{x:Type ComboBox}" TargetType="ComboBox">
                <Setter Property="Foreground" Value="{DynamicResource Text}" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="MaxDropDownHeight" Value="240" />
                <Setter Property="Template">
                    <ControlTemplate>
                        <Panel>
                            <Border Name="bd" Background="{DynamicResource Glass2}" BorderBrush="{DynamicResource Line2}"
                                    BorderThickness="1" CornerRadius="8" Padding="10,0">
                                <Grid ColumnDefinitions="*,Auto">
                                    <ContentControl Content="{TemplateBinding SelectionBoxItem}"
                                                    ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                    VerticalAlignment="Center" />
                                    <c:Icon Grid.Column="1" Kind="chevron-down" Width="14" Height="14"
                                            Margin="8,0,0,0" Foreground="{DynamicResource TextMuted}" />
                                </Grid>
                            </Border>
                            <Popup Name="PART_Popup" WindowManagerAddShadowHint="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen, Mode=TwoWay}"
                                   MinWidth="{Binding Bounds.Width, RelativeSource={RelativeSource TemplatedParent}}"
                                   MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                   PlacementTarget="bd" Placement="Bottom"
                                   IsLightDismissEnabled="True" InheritsTransform="True">
                                <Border Background="{DynamicResource MenuBg}" BorderBrush="{DynamicResource Line2}"
                                    BorderThickness="1" CornerRadius="8" Margin="0,4,0,0" Padding="4" h:Motion.PopupReveal="True">
                                    <ScrollViewer>
                                        <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Panel>
                    </ControlTemplate>
                </Setter>
                <Style Selector="^:pointerover /template/ Border#bd">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentLine}" />
                </Style>
            </ControlTheme>

            <!-- ===== Usage bar (drive pages): rounded track + accent fill ===== -->
            <ControlTheme x:Key="UsageBar" TargetType="ProgressBar">
                <Setter Property="Height" Value="8" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Minimum" Value="0" />
                <Setter Property="Maximum" Value="100" />
                <Setter Property="Template">
                    <ControlTemplate>
                        <Panel>
                            <Border Background="{DynamicResource Glass3}" CornerRadius="4" />
                            <Border Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="4"
                                    Background="{DynamicResource GradientAccent}" />
                        </Panel>
                    </ControlTemplate>
                </Setter>
            </ControlTheme>

            <!-- ===== ScrollBar: slim, always-visible thumb ===== -->
            <ControlTheme x:Key="RainScrollThumb" TargetType="Thumb">
                <Setter Property="Background" Value="{DynamicResource ScrollThumbBrush}" />
                <Setter Property="Template">
                    <ControlTemplate>
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Margin="2" />
                    </ControlTemplate>
                </Setter>
                <Style Selector="^:pointerover">
                    <Setter Property="Background" Value="{DynamicResource AccentLine}" />
                </Style>
            </ControlTheme>
            <ControlTheme x:Key="RainScrollPage" TargetType="RepeatButton">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Template">
                    <ControlTemplate>
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter>
            </ControlTheme>
            <ControlTheme x:Key="{x:Type ScrollBar}" TargetType="ScrollBar">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Cursor" Value="Arrow" />
                <Setter Property="Template">
                    <ControlTemplate>
                        <Border Background="Transparent">
                            <Track Name="track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                                   Value="{TemplateBinding Value, Mode=TwoWay}"
                                   ViewportSize="{TemplateBinding ViewportSize}"
                                   Orientation="{TemplateBinding Orientation}"
                                   IsDirectionReversed="True">
                                <Track.DecreaseButton>
                                    <RepeatButton Name="PART_PageUpButton" Theme="{StaticResource RainScrollPage}" />
                                </Track.DecreaseButton>
                                <Track.IncreaseButton>
                                    <RepeatButton Name="PART_PageDownButton" Theme="{StaticResource RainScrollPage}" />
                                </Track.IncreaseButton>
                                <Thumb Theme="{StaticResource RainScrollThumb}" />
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter>
                <Style Selector="^:vertical">
                    <Setter Property="Width" Value="12" />
                </Style>
                <Style Selector="^:horizontal">
                    <Setter Property="Height" Value="12" />
                </Style>
                <Style Selector="^:horizontal /template/ Track#track">
                    <Setter Property="IsDirectionReversed" Value="False" />
                </Style>
            </ControlTheme>

            <!-- ===== Browser-style folder tab: glass when active, accent underline + accent icon ===== -->
            <ControlTheme x:Key="TabItem" TargetType="ListBoxItem">
                <Setter Property="Margin" Value="2,0,0,0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
                <Setter Property="VerticalAlignment" Value="Bottom" />
                <Setter Property="ToolTip.ShowDelay" Value="450" />
                <Setter Property="ToolTip.Placement" Value="Bottom" />
                <Setter Property="ToolTip.VerticalOffset" Value="5" />
                <Setter Property="Template">
                    <ControlTemplate x:DataType="vm:TabViewModel">
                        <Panel Name="root" RenderTransformOrigin="50%,50%" RenderTransform="scale(1)" Classes.dragging="{Binding IsDragging}">
                            <Panel.Transitions>
                                <Transitions>
                                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.13" />
                                </Transitions>
                            </Panel.Transitions>
                            <Border Name="bg" Background="Transparent" CornerRadius="8,8,0,0"
                                    BorderBrush="Transparent" BorderThickness="1,1,1,0"
                                    Padding="8,6" ClipToBounds="True"
                                    Classes.active="{Binding IsActive}"
                                    Classes.drop="{Binding IsDropTarget}"
                                    Classes.groupDrop="{Binding IsGroupDropTarget}"
                                    Classes.pinned="{Binding IsPinned}">
                                <DockPanel>
                                    <Border Name="groupBadge" DockPanel.Dock="Right" IsVisible="{Binding IsGroupLeader}"
                                            Background="{DynamicResource AccentWash}" BorderBrush="{DynamicResource AccentLine}"
                                            BorderThickness="1" CornerRadius="5" Padding="5,1" Margin="6,0,0,0"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding GroupCount}" Foreground="{DynamicResource AccentBright}"
                                                   FontSize="9" FontWeight="SemiBold" />
                                    </Border>
                                    <c:Icon Name="ico" DockPanel.Dock="Left" Kind="folder" Width="14" Height="14"
                                            Margin="0,0,6,0" VerticalAlignment="Center"
                                            Foreground="{DynamicResource TextMuted}" />
                                    <Button Name="close" DockPanel.Dock="Right" Theme="{StaticResource TabCloseButton}"
                                            Margin="4,0,0,0" Classes="tabClose" ToolTip.Tip="Close tab (Ctrl+W)"
                                            AutomationProperties.Name="Close tab"
                                            IsVisible="{Binding !IsGroupLeader}" />
                                    <Button Name="groupClose" DockPanel.Dock="Right" Theme="{StaticResource TabCloseButton}"
                                            Margin="4,0,0,0" Classes="groupClose" ToolTip.Tip="Close tab group"
                                            AutomationProperties.Name="Close tab group"
                                            IsVisible="{Binding IsGroupLeader}" />
                                    <TextBlock Name="title" Text="{Binding TopLevelTitle}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </Border>
                            <!-- accent underline on the active tab -->
                            <Border Name="ul" Height="2" CornerRadius="2" VerticalAlignment="Bottom" Margin="10,0"
                                    Background="{DynamicResource GradientAccent}" BoxShadow="{DynamicResource TabGlow}"
                                    IsVisible="{Binding IsActive}" />
                            <Border Name="groupRail" Height="3" CornerRadius="2" VerticalAlignment="Top" Margin="8,0"
                                    Background="{DynamicResource AccentBright}" IsVisible="{Binding IsGrouped}" />
                        </Panel>
                    </ControlTemplate>
                </Setter>
                <Style Selector="^:pointerover /template/ Border#bg">
                    <Setter Property="Background" Value="{DynamicResource Glass3}" />
                </Style>
                <Style Selector="^ /template/ Border#bg.active">
                    <Setter Property="Background" Value="{DynamicResource Glass3}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Line2}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Text}" />
                </Style>
                <Style Selector="^ /template/ Border#bg.active c|Icon#ico">
                    <Setter Property="Foreground" Value="{DynamicResource AccentBright}" />
                </Style>
                <!-- File drag hovering this tab: accent drop highlight -->
                <Style Selector="^ /template/ Border#bg.drop">
                    <Setter Property="Background" Value="{DynamicResource AccentWash}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentLine}" />
                </Style>
                <Style Selector="^ /template/ Border#bg.drop c|Icon#ico">
                    <Setter Property="Foreground" Value="{DynamicResource AccentBright}" />
                </Style>
                <Style Selector="^ /template/ Border#bg.groupDrop">
                    <Setter Property="Background" Value="{DynamicResource AccentWash2}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBright}" />
                </Style>
                <Style Selector="^ /template/ Panel#root.dragging">
                    <Setter Property="ZIndex" Value="20" />
                    <Setter Property="Opacity" Value="0.72" />
                    <Setter Property="RenderTransform" Value="scale(0.96)" />
                </Style>
                <!-- Pinned tabs mimic browser favicons: compact, kept at the left,
                     and their close affordance stays in the context menu. -->
                <Style Selector="^ /template/ Border#bg.pinned">
                    <Setter Property="Padding" Value="11,6" />
                </Style>
                <Style Selector="^ /template/ Border#bg.pinned c|Icon#ico">
                    <Setter Property="Margin" Value="0" />
                </Style>
                <Style Selector="^ /template/ Border#bg.pinned TextBlock#title">
                    <Setter Property="IsVisible" Value="False" />
                </Style>
                <Style Selector="^ /template/ Border#bg.pinned Button#close">
                    <Setter Property="IsVisible" Value="False" />
                </Style>
            </ControlTheme>

            <!-- Compact second-row member tabs (two-level tab stacks). -->
            <ControlTheme x:Key="GroupChildTab" TargetType="ListBoxItem">
                <Setter Property="Margin" Value="2,0,0,0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
                <Setter Property="ToolTip.ShowDelay" Value="450" />
                <Setter Property="ToolTip.Placement" Value="Bottom" />
                <Setter Property="Template">
                    <ControlTemplate x:DataType="vm:TabViewModel">
                        <Border Name="bg" Background="Transparent" CornerRadius="7"
                                BorderBrush="Transparent" BorderThickness="1"
                                Padding="7,4" ClipToBounds="True" RenderTransformOrigin="50%,50%"
                                Classes.active="{Binding IsActive}"
                                Classes.groupDrop="{Binding IsGroupDropTarget}"
                                Classes.dragging="{Binding IsDragging}" RenderTransform="scale(1)">
                            <Border.Transitions>
                                <Transitions>
                                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.13" />
                                </Transitions>
                            </Border.Transitions>
                            <DockPanel>
                                <c:Icon Name="ico" DockPanel.Dock="Left" Kind="folder" Width="12" Height="12"
                                        Margin="0,0,5,0" VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}" />
                                <Button Name="close" DockPanel.Dock="Right" Theme="{StaticResource TabCloseButton}"
                                        Width="17" Height="17" Margin="4,0,0,0" Classes="tabClose"
                                        ToolTip.Tip="Close tab (Ctrl+W)" AutomationProperties.Name="Close tab" />
                                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                        </Border>
                    </ControlTemplate>
                </Setter>
                <Style Selector="^:pointerover /template/ Border#bg">
                    <Setter Property="Background" Value="{DynamicResource Glass3}" />
                </Style>
                <Style Selector="^ /template/ Border#bg.active">
                    <Setter Property="Background" Value="{DynamicResource AccentWash}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentLine}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Text}" />
                </Style>
                <Style Selector="^ /template/ Border#bg.active c|Icon#ico">
                    <Setter Property="Foreground" Value="{DynamicResource AccentBright}" />
                </Style>
                <Style Selector="^ /template/ Border#bg.groupDrop">
                    <Setter Property="Background" Value="{DynamicResource AccentWash2}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBright}" />
                </Style>
                <Style Selector="^ /template/ Border#bg.dragging">
                    <Setter Property="Opacity" Value="0.72" />
                    <Setter Property="RenderTransform" Value="scale(0.96)" />
                </Style>
            </ControlTheme>

            <!-- Details column header: uppercase micro-label, sort-clickable -->
            <ControlTheme x:Key="ColumnHeader" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource TextFaint}" />
                <Setter Property="Height" Value="30" />
                <Setter Property="Padding" Value="10,0" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="Template">
                    <ControlTemplate>
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <TextBlock Text="{TemplateBinding Content, Converter={x:Static c:UpperConverter.Instance}}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontWeight="{TemplateBinding FontWeight}"
                                       FontSize="{TemplateBinding FontSize}" TextTrimming="CharacterEllipsis" />
                        </Border>
                    </ControlTemplate>
                </Setter>
                <Style Selector="^:pointerover">
                    <Setter Property="Foreground" Value="{DynamicResource AccentBright}" />
                </Style>
            </ControlTheme>

            <!-- Column resize grip on a header's right edge -->
            <ControlTheme x:Key="ColumnGrip" TargetType="Thumb">
                <Setter Property="Width" Value="7" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Cursor" Value="SizeWestEast" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="Template">
                    <ControlTemplate>
                        <Border Background="{TemplateBinding Background}" />
                    </ControlTemplate>
                </Setter>
            </ControlTheme>
        </ResourceDictionary>
    </Styles.Resources>

    <!-- ===== Window-wide defaults ===== -->
    <Style Selector="Window">
        <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
    </Style>

    <!-- Keep the slim scroll bar visible instead of Fluent's auto-hiding overlay. -->
    <Style Selector="ScrollViewer">
        <Setter Property="AllowAutoHide" Value="False" />
    </Style>

    <!-- ===== TextBox (address / filter / dialogs) — frosted, rounded (FieldBox) ===== -->
    <Style Selector="TextBox.field">
        <Setter Property="Background" Value="{DynamicResource Glass2}" />
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Line2}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="CaretBrush" Value="{DynamicResource AccentBright}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentWash2}" />
        <Setter Property="SelectionForegroundBrush" Value="{DynamicResource Text}" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Height" Value="30" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBox.field:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource Glass2}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Line2}" />
    </Style>
    <Style Selector="TextBox.field:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource Glass3}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentLine}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="TextBox.field:pointerover, TextBox.field:focus">
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
    </Style>
    <Style Selector="TextBox.field /template/ TextBlock#PART_Watermark, TextBox.bare /template/ TextBlock#PART_Watermark">
        <Setter Property="Foreground" Value="{DynamicResource TextFaint}" />
    </Style>
    <Style Selector="TextBox.field:disabled /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource Glass1}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Line1}" />
    </Style>

    <!-- Chrome-less text input (search pill, path edit box): no border, no fill (BareBox) -->
    <Style Selector="TextBox.bare">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="CaretBrush" Value="{DynamicResource AccentBright}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentWash2}" />
        <Setter Property="SelectionForegroundBrush" Value="{DynamicResource Text}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBox.bare /template/ Border#PART_BorderElement, TextBox.bare:pointerover /template/ Border#PART_BorderElement, TextBox.bare:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="TextBox.bare:pointerover, TextBox.bare:focus">
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
    </Style>

    <!-- Inline rename / new-folder editor: small frosted field with an accent edge. -->
    <Style Selector="TextBox.inline">
        <Setter Property="Background" Value="{DynamicResource Glass3}" />
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="CaretBrush" Value="{DynamicResource AccentBright}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentWash2}" />
        <Setter Property="SelectionForegroundBrush" Value="{DynamicResource Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentLine}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="7,2" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBox.inline:pointerover /template/ Border#PART_BorderElement, TextBox.inline:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource Glass3}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentLine}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="TextBox.inline:pointerover, TextBox.inline:focus">
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
    </Style>

    <!-- Selectable read-only text keeps the theme's accent selection. -->
    <Style Selector="SelectableTextBlock">
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentWash2}" />
    </Style>

    <Style Selector="ToolTip">
        <!-- Fluent already fades tooltips; a second opacity animation restarts that transition. -->
        <Setter Property="Background" Value="{DynamicResource MenuBg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Line2}" />
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>

    <Style Selector="GridSplitter">
        <Setter Property="Background" Value="{DynamicResource Line1}" />
        <Setter Property="MinWidth" Value="0" />
    </Style>

    <!-- Indeterminate thin busy bar at the top of a pane -->
    <Style Selector="ProgressBar.busy">
        <Setter Property="Foreground" Value="{DynamicResource Accent}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="MinHeight" Value="2" />
        <Setter Property="Height" Value="2" />
    </Style>
</Styles>
