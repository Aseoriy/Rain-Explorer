<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>RainExplorer</AssemblyName>
    <RootNamespace>RainExplorer</RootNamespace>
    <ApplicationIcon>Assets\rain.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- X11's fixed 60 Hz clock has no public option in 11.3.22. RenderPerformance
         bridges that pinned implementation; revalidate it when upgrading Avalonia. -->
    <AvaloniaAccessUnstablePrivateApis>true</AvaloniaAccessUnstablePrivateApis>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- statx(2) is read by fixed offsets from a stack buffer (Services/UnixStat.cs). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- Product / version metadata (shown in the About section). -->
    <Product>Rain Explorer</Product>
    <Company>Aseoriy</Company>
    <Authors>Aseoriy</Authors>
    <Copyright>© 2026 Aseoriy</Copyright>
    <Version>0.1.0-linux-alpha</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="[11.3.22]" />
    <PackageReference Include="Avalonia.Desktop" Version="[11.3.22]" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="[11.3.22]" />
    <!-- Avalonia's 0.21.3 uses synchronous D-Bus callbacks after dispatcher shutdown.
         0.92.0 includes non-blocking callbacks and the subsequent security fixes. -->
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.92.0" />
    <!-- Desktop icon themes ship SVG icons; Svg.Skia renders them with Avalonia's SkiaSharp (2.88). -->
    <PackageReference Include="Svg.Skia" Version="3.7.0" />
    <!-- Diagnostics (F12 dev tools) only in Debug builds. -->
    <PackageReference Include="Avalonia.Diagnostics" Version="[11.3.22]" Condition="'$(Configuration)' == 'Debug'" />
  </ItemGroup>

</Project>
